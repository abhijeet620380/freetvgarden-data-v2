    "countryChannelsParagraphEmpty": "{countryName} ཡི་རིན་མེད་བརྙན་འཕྲིན་གྱི་བརྙན་འཕྲིན་ཁང་དེ་ཚོ་སྤྱི་པའི་iptv-org བརྙན་འཕྲིན་གྱི་སྣོད་ཐོ་ནས་ཐད་གཏོང་བྱེད་ཀྱི་ཡོད། རིན་མེད་ཀྱི་བརྙན་འཕྲིན་བསྡུ་རུབ་བྱེད་མཁན་གང་རུང་དང་འདྲ་བར། བརྙན་འཕྲིན་གྱི་ཐོ་གཞུང་ངེས་ཅན་དེ་ཉིན་རེ་བཞིན་བརྙན་འཕྲིན་འགྲོ་བཞིན་པའི་སྐབས་དང་དྲ་རྒྱའི་ཕྱི་རོལ་དུ་འགྱུར་བ་འགྲོ་སྲིད་པ་རེད།",
    "countryChannelsParagraphOne": "ཕི་རི་ཊི་ཝི་ལྡུམ་རའི་ད་ལྟ་{count} ཐད་གཏོང་{countryName} བརྙན་འཕྲིན་ཐོ་འགོད་བྱེད་ཀྱི་ཡོད། དེའི་ནང་{names} ཡང་ཚུད་ཡོད། རིན་མེད་ཀྱི་བརྙན་འཕྲིན་བསྡུ་རུབ་བྱེད་མཁན་གང་རུང་དང་འདྲ་བར། བརྙན་འཕྲིན་གྱི་ཐོ་གཞུང་ངེས་ཅན་དེ་ཉིན་རེ་བཞིན་བརྙན་འཕྲིན་འགྲོ་བཞིན་པའི་སྐབས་དང་དྲ་རྒྱའི་ཕྱི་རོལ་དུ་འགྱུར་བ་འགྲོ་སྲིད་པ་རེད།",
    "countryChannelsParagraphMany": "ཕི་རི་ཊི་ཝི་ལྡུམ་རའི་ད་ལྟ་{count} ཐད་གཏོང་{countryName} བརྙན་འཕྲིན་ཐོ་འགོད་བྱེད་ཀྱི་ཡོད། དེའི་ནང་{names} ཡང་ཚུད་ཡོད། རིན་མེད་ཀྱི་བརྙན་འཕྲིན་བསྡུ་རུབ་བྱེད་མཁན་གང་རུང་དང་འདྲ་བར། བརྙན་འཕྲིན་གྱི་ཐོ་གཞུང་ངེས་ཅན་དེ་ཉིན་རེ་བཞིན་བརྙན་འཕྲིན་འགྲོ་བཞིན་པའི་སྐབས་དང་དྲ་རྒྱའི་ཕྱི་རོལ་དུ་འགྱུར་བ་འགྲོ་སྲིད་པ་རེད།",
