    if(!n){for(var i=1;i<=5;i++){if(posStats(i).free>0){n=i;break}}if(!n){for(i=1;i<=5;i++){if(SIZES.some(function(z){return bookable(i,z)})){n=i;break}}}n=n||1}
    sh.pos=n;sh.start="";sh.size=(size&&bookable(n,size))?szName(size):bestSize(n);
    renderSheet();panel.querySelector("#ft-sp-sheet").classList.add("open");panel.querySelector("#ft-sp-sheet .ft-sp-sh-body").scrollTop=0;
    document.documentElement.classList.add("ft-sp-lock");try{panel.querySelector("#ft-sp-sheet .ft-sp-x").focus({preventScroll:true})}catch(e){}   // stop page scrolling behind the popup + keyboard focus on Close
    track("sponsored_sheet_open","",{position:String(n),slot:codeOf(n,sh.size)});
  }
  function closeSheet(){var el=panel&&panel.querySelector("#ft-sp-sheet");if(el)el.classList.remove("open");document.documentElement.classList.remove("ft-sp-lock")}
  function sheetOpen(){var el=panel&&panel.querySelector("#ft-sp-sheet");return !!(el&&el.classList.contains("open"))}
  // SLOT BOARD (top-level "rateCard" in sponsored.json). 5 positions x 3 sizes = 15 slots, each with its price.
  // A position is "BOOKED" automatically while an entry with that "position" is running (and FREE again when it ends).
  // Booked positions show "Next available from <date>" (end of the last booking in a row) with Telegram + Email booking buttons.
  // "reserved":[4] marks a position ON HOLD by hand. Old style rateCard with a plain "slots" list still works.
  function renderRates(r,list){
    if(!r||typeof r!=="object")return"";
    var open=r.open===true,title=esc(r.title||"Ad slots & prices"),bodyH="",sumH="",now=Date.now();
    if(Array.isArray(r.positions)&&r.positions.length){
      var freeN=0,total=0,fi=freeInfo();
      var rows=r.positions.slice(0,5).map(function(x,i){x=x||{};var n=parseInt(x.n,10)||i+1,t=TIERS[n]||TIERS[5];
        var ps=posStats(n),info="",bk="",firstFree=null;freeN+=ps.free;total+=ps.open;
        // one cell per size: EACH SIZE HAS ITS OWN STATUS (booking 1L leaves 1M and 1S free)
        var cells=[["small","S","SMALL"],["medium","M","MEDIUM"],["large","L","LARGE"]].map(function(c){
          var si=slotInfo(n,c[0]),cls=si.closed?'off':(si.free?'ok':'no'),
              em=si.closed?'Not available':si.free?'Vacant':si.hd?'On hold':'Booked',
              pr=si.closed?'—':(fi?'<b class="fr"><s>'+esc(x[c[0]]||"")+'</s><span>FREE</span></b>':'<b>'+esc(x[c[0]]||"—")+'</b>');
          return'<div class="ft-sp-pc '+cls+'"><i>'+c[1]+' · '+c[2]+'</i>'+pr+'<em>'+em+'</em></div>'}).join("");
        ["large","medium","small"].forEach(function(z){var si=slotInfo(n,z),code=codeOf(n,z);
          if(si.closed)return;
          if(si.free){if(!firstFree)firstFree=z;if(si.upcoming)info+='<div class="ft-sp-until">'+code+' free now · next booking starts '+esc(fmtDT(si.upcoming))+'</div>';return}
          if(si.cur){info+='<div class="ft-sp-until">'+code+' · '+(si.cur.e?'Booked until '+esc(fmtDT(si.cur.e)):'Booked (no end date)')+'</div>';
            if(si.nextFree){info+='<div class="ft-sp-next">📅 '+code+' next available from '+esc(fmtDT(si.nextFree))+'</div>';bk+=bookBtn(n,"Book "+szCap(z)+" from "+fmtDT(si.nextFree),z)}
            else if(si.openEnded)info+='<div class="ft-sp-next">'+code+': contact us for the next date</div>'}
          else if(si.hd)info+='<div class="ft-sp-until">'+code+' · On hold</div>'});
        if(firstFree)bk=bookBtn(n,fi?"Book free slot":"Book now",firstFree)+bk;
        var st=ps.free&&ps.free===ps.open?'<span class="ft-sp-st free">● AVAILABLE</span>':(ps.free?'<span class="ft-sp-st free">● '+ps.free+' OF '+ps.open+' FREE</span>':(ps.open?'<span class="ft-sp-st taken">BOOKED</span>':'<span class="ft-sp-st hold">NOT AVAILABLE</span>'));
        return'<div class="ft-sp-pos '+(ps.free?'free':'taken')+'"><div class="ft-sp-pos-top"><span class="ft-sp-tag ft-sp-c-'+t.cls+'">'+(t.icon?t.icon+" ":"")+esc(x.tag||t.name)+'</span><span class="ft-sp-pos-name">'+esc(x.name||("Position "+n))+'</span>'+st+'</div><div class="ft-sp-prices">'+cells+'</div>'+info+bk+'</div>'}).join("");
      sumH=freeN?'<span class="ft-sp-sum ok">🟢 '+freeN+' of '+total+' slots available'+(fi?' · FREE':'')+'</span>':'<span class="ft-sp-sum full">🔴 All '+total+' slots booked</span>';
      // ACTUAL-SIZE PREVIEW of the three card sizes
      var sm=function(sz,extra){return renderItem(Object.assign({__i:-1,__sample:true,__pk:true,id:"sample-"+sz,label:"Promoted",size:sz,title:"Your title goes here",text:"A short line about your website, app, product or channel. Keep it clear and simple.",link:"/",button:"Visit",__ph:true,price:"₹59 / 24h",end:new Date(Date.now()+864e5).toISOString()},extra||{}))};
      var guide='<button type="button" class="ft-sp-gtog" data-show="📐 See the actual size of Small / Medium / Large" data-hide="Hide size preview">📐 See the actual size of Small / Medium / Large</button><div class="ft-sp-guide">'+
        '<div class="ft-sp-gcap"><b>SMALL</b> — compact list row, 96 px high: 64 px picture, all tags on top, 1-line title, 1 line of text, tap anywhere to open.</div>'+sm("small")+
        '<div class="ft-sp-gcap"><b>MEDIUM</b> — card 196 px high: picture on the left, title (2 lines), text (3 lines), small button.</div>'+sm("medium")+
        '<div class="ft-sp-gcap"><b>LARGE</b> — biggest card (max 440 px): wide picture on top, bigger title (2 lines), text (4 lines), button.</div>'+sm("large")+
        '<div class="ft-sp-gcap">Every slot shows its price, size and end date. Top 3 positions get special cards (#1 red, #2 purple, #3 orange) with bigger heading text. A slot never grows bigger than its size. Booking one size of a position does not block the other two.</div></div>';
      bodyH='<button type="button" class="ft-sp-startbook" data-sheet="0">📝 Book an ad slot</button><div class="ft-sp-legend">'+esc(r.legend||"Each size (Small / Medium / Large) of a position is booked on its own. Green = available to book.")+'</div>'+guide+rows;
    }else if(Array.isArray(r.slots)&&r.slots.length){
      bodyH=r.slots.slice(0,15).map(function(x){x=x||{};var sub=[x.size,x.position,x.note].filter(Boolean).map(esc).join(" · ");
        return'<div class="ft-sp-rate"><div class="ft-sp-rn"><b>'+esc(x.name||"")+'</b>'+(sub?'<span>'+sub+'</span>':"")+'</div><div class="ft-sp-rp">'+esc(x.price||"")+'</div></div>'}).join("");
    }else return"";
    return'<div class="ft-sp-rates'+(open?' open':'')+'" id="ft-sp-rates"><span class="ft-sp-badges"><span class="ft-sp-tag ft-sp-c-gold">'+esc(r.label||"Advertise")+'</span>'+sumH+'</span><div class="ft-sp-inner"><div class="ft-sp-h">'+title+'</div>'+
      '<div class="ft-sp-rates-body">'+bodyH+(r.note?'<div class="ft-sp-t" style="margin-top:8px;font-size:.78rem;color:#8e8e93">'+esc(r.note)+'</div>':"")+'</div></div>'+
      '<button type="button" class="ft-sp-tog" data-rates="1" data-show="'+esc(r.button||"View all 15 slots & availability")+'" data-hide="Hide slots">'+esc(open?"Hide slots":(r.button||"View all 15 slots & availability"))+'</button></div>'}
  function renderItem(it){
    var id=it.id||("i"+it.__i), tag=esc(it.label||(it.html?"Ad":"Sponsored")),
        link=safeUrl(it.link), h="";
    var sz=String(it.size||(it.pinned?"large":"medium")).toLowerCase();
    var szc=sz==="large"||sz==="l"?"l":(sz==="small"||sz==="s"?"s":"m");            // fixed card size: s / m / l
    var pos=Math.max(0,Math.min(5,parseInt(it.position,10)||0)),tier=TIERS[pos]||null;   // position 1-5 (1 = top)
    var pk=!!(pos||it.__pk)&&!it.html;       // paid slot (has a position): gets a FIXED size layout. Entries without a position keep the normal flexible card.
    // label colour: a preset name (green gold red blue purple orange gray silver bronze) or any hex colour
    var lc=String(it.labelColor||""),lcls="",lsty="";
    if(!lc&&tier)lc=tier.cls;                      // no labelColor given: use the position's colour (gold / silver / bronze ...)
    if(/^(green|gold|red|blue|purple|orange|gray|silver|bronze|platinum)$/i.test(lc))lcls=" ft-sp-c-"+lc.toLowerCase();
    else if(/^#[0-9a-f]{3,8}$/i.test(lc))lsty=' style="color:'+lc+';border-color:'+lc+';background:'+lc+'26"';
    // accent colour for the heading + card border (preset or hex)
    var ac=String(it.color||""),acHex={green:"#32d74b",gold:"#ffd60a",red:"#ff6961",blue:"#64b5ff",purple:"#c9a0ff",orange:"#ffb340",gray:"#d1d1d6",silver:"#c7ccd6",platinum:"#cfd6e4",bronze:"#ff9f5a"};
    ac=acHex[ac.toLowerCase()]||(/^#[0-9a-f]{3,8}$/i.test(ac)?ac:"");
    var small=pk&&szc==="s";                       // small slots are a compact list row: label + tier in the badges, details in ONE line under the text
    var sizeName=szc==="s"?"Small":szc==="m"?"Medium":"Large";
    var chips=small?"":(Array.isArray(it.tags)?it.tags.slice(0,4):[]).map(function(t){return'<span class="ft-sp-chip">'+esc(t)+'</span>'}).join("");
    // EVERY SLOT SHOWS: price, size and end date.  (price comes from the rateCard table; vacant slots say "Available")
    var endMs=parseDate(it.end,true),endTxt=it.__vac?"🟢 Available now":(endMs?"Ends "+fmtDT(endMs):"");
    var cdLive=it.countdown&&endMs&&!it.__vac;
    var priceTxt=it.price?"🏷️ "+it.price:"";
    var metaParts=[priceTxt,pk?"📐 "+sizeName:"",cdLive?"":endTxt].filter(Boolean);
    var cdSpan=cdLive?'<span class="ft-sp-cd" data-end="'+endMs+'">⏳ '+esc(leftText(endMs-Date.now()))+'</span>':"";
    if(!pk&&endMs&&!it.__vac)metaParts=[priceTxt,cdLive?"":endTxt].filter(Boolean);
    var metaLine=esc(metaParts.join("  ·  "))+(cdSpan?(metaParts.length?"  ·  ":"")+cdSpan:"");
    var priceTag="";
    // all details go in the TAG ROW at the top of the card: price, size, end date (or live countdown)
    if(it.price)chips+='<span class="ft-sp-chip ft-sp-price">'+esc(priceTxt)+'</span>';
    if(pk)chips+='<span class="ft-sp-chip">📐 '+sizeName+'</span>';
    if(cdLive)chips+='<span class="ft-sp-chip ft-sp-cd" data-end="'+endMs+'">⏳ '+esc(leftText(endMs-Date.now()))+'</span>';
    else if(endTxt)chips+='<span class="ft-sp-chip'+(it.__vac?' ft-sp-ok':'')+'">'+esc(endTxt)+'</span>';
    var badges='<div class="ft-sp-badges"><span class="ft-sp-tag'+lcls+'"'+lsty+'>'+tag+'</span>'+
      (tier&&!it.__vac?'<span class="ft-sp-tag tier ft-sp-c-'+tier.cls+'">'+tier.icon+' '+tier.name+'</span>':'')+(it.pinned&&!tier?'<span class="ft-sp-tag ft-sp-c-gold">📌 Pinned</span>':'')+chips+'</div>';
    var cls='ft-sp-item'+(it.pinned?' ft-sp-pinned':'')+(pk?' ft-sp-pk ft-sp-sz-'+szc:'')+(pos&&!it.__vac?' ft-sp-p'+pos:'')+(it.__sample?' ft-sp-sample':'')+(it.__vac?' ft-sp-vac':'')+(it.html?' ft-sp-ad':'');
    var open='<div class="'+cls+'" data-id="'+esc(id)+'"'+(pos&&!it.__vac&&!it.__sample?' data-slot="'+pos+'"':'')+(ac?' style="border-color:'+ac+'"':'')+'>';
    // heading colour: white by default. "titleColor" = any colour (preset name or hex), independent of the card border colour.
    var tc=String(it.titleColor||"").toLowerCase(),tcv=acHex[tc]||(/^#[0-9a-f]{3,8}$/i.test(tc)?tc:"");
    var hStyle=tcv?' style="color:'+tcv+'"':'';
    var imgUrl=safeUrl(it.image);

    if(it.html){
      /* RAW AD CODE. Runs inside a sandboxed iframe, so it cannot read or change FreeTV Garden itself.
         allow-scripts  : ad scripts can run;  allow-popups : ad clicks can open the advertiser's page.
         Default = NO allow-same-origin (safest). Ad networks that refuse to render in that mode can be
         switched on per entry with "sameOrigin": true  (only do that for code you trust). */
      var sb="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-forms"+(it.sameOrigin===true?" allow-same-origin":"");
      var hgt=Math.max(40,Math.min(1200,parseInt(it.height,10)||250));
      var doc='<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'+
        '<style>html,body{margin:0;padding:0;background:transparent;text-align:center}body{display:flex;justify-content:center;align-items:flex-start}img,iframe{max-width:100%}</style></head><body>'+it.html+'</body></html>';
      var bg=/^(#[0-9a-f]{3,8}|rgba?\([\d\s.,%]+\)|[a-z]+)$/i.test(String(it.background||""))?it.background:"transparent";   // optional per-ad background colour
      return open+badges+'<iframe class="ft-sp-frame" style="height:'+hgt+'px;background:'+bg+'" sandbox="'+sb+'" loading="lazy" srcdoc="'+esc(doc)+'"></iframe></div>';
