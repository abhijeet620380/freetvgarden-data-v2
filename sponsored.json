    // ---------- text part ----------
    var inner="";
    if(it.title||it.text||(link&&it.button)||it.contacts||it.more){
      inner='<div class="ft-sp-inner">';
      if(it.title)inner+='<div class="ft-sp-h"'+hStyle+'>'+esc(it.title)+'</div>';
      if(it.text)inner+='<div class="ft-sp-t ft-sp-tx">'+md(it.text)+'</div>';
      inner+=renderContacts(it.contacts);
      if(it.more)inner+='<div class="ft-sp-more ft-sp-t">'+md(it.more)+'</div>';
      if(link&&it.button)inner+='<a class="ft-sp-btn" data-sp="'+esc(id)+'" href="'+esc(link)+'" target="_blank" rel="sponsored nofollow noopener noreferrer">'+esc(it.button)+'</a>';
      inner+='</div>';
    }
    var tog=it.more?'<button type="button" class="ft-sp-tog" data-show="'+esc(it.moreLabel||"Show more pricing & details")+'" data-hide="'+esc(it.lessLabel||"Show less")+'">'+esc(it.moreLabel||"Show more pricing & details")+'</button>':'';

    // MEDIUM SLOT: picture on the left, text on the right (fixed height)
    if(pk&&szc==="m")return open+badges+'<div class="ft-sp-mbody">'+imLinked+inner+'</div></div>';
    // LARGE slot / normal card: picture on top, then text
    return open+badges+imLinked+inner+tog+'</div>';
  }
  // VACANT SLOTS: your own ad ("rateCard.vacant.html", tag "Ad") and "Advertise here" messages (tag "Advertise").
  // They are ALWAYS shown AFTER all paid slots - never above a paid slot or between two paid slots.
  function vacantMsg(n){
    var v=(rateCard&&rateCard.vacant)||{},fs=["large","medium","small"].filter(function(z){return slotInfo(n,z).free}),
        low=fs.length?fs[fs.length-1]:"small",fi=freeInfo();
    return renderItem({__i:-1,__vac:true,id:"vacant-"+n,position:n,size:"small",label:v.messageLabel||"Advertise",
      title:v.title||"Advertise here",text:(fs.length?"Available: "+fs.map(szCap).join(" · ")+". ":"")+(v.text||"Promote your website, app or channel here."),
      link:"#board",button:v.button||"Book this slot",price:priceFor(n,low)});
  }
  // minimum price in the rateCard table (e.g. "₹9"), used by the default offer text
  function minPrice(){var best=null,P=(rateCard&&rateCard.positions)||[];
    P.forEach(function(x){["small","medium","large"].forEach(function(k){var m=money(x&&x[k]);if(m&&(best===null||m.n<best.n))best=m})});
    return best?fmtMoney(best,best.n):""}
  // HERO = offer + slot status in one block. top-level "offer": {"price":"₹9","priceNote":"for 24 hr","text":"...","more":"...","button":"Show more","open":false,"enabled":false}
  // price defaults to the lowest price in the table.
  function offerHtml(){
    var o=offer;if(o===false)return"";
    if(!o||typeof o!=="object")o={};
    if(o.enabled===false)return"";
    var price=o.price||(slotMode()?minPrice():""),note=o.priceNote||"for 24 hr",text=o.text||(slotMode()?"Anyone can book a slot":""),fz=slotMode()?freeInfo():null;
    if(fz){price="FREE";note=fz.until?"until "+fmtD(fz.until):"launch offer";if(fz.badge)text=fz.badge}   // FREE period: big price becomes FREE
    if(!price&&!text)return"";
    var tx=text?md(text).replace(/^<p[^>]*>|<\/p>$/g,"").replace(/<\/p><p[^>]*>/g,"<br>"):"";
    var dots="";
    if(slotMode()){var n5=Math.min(5,rateCard.positions.length),fr=0,tt=0;dots='<div class="ft-sp-dots">';
      for(var q=1;q<=n5;q++){var qi=posStats(q);fr+=qi.free;tt+=qi.open;dots+='<button type="button" class="ft-sp-dot2 '+(qi.free?'free':'busy')+'" data-strip="'+q+'" title="Position #'+q+': '+qi.free+' of '+qi.open+' sizes free">'+q+'</button>'}
      dots+='<em>'+fr+' of '+tt+' slots free</em></div>'}
    var moreSrc=(fz&&fz.more)||o.more,more=moreSrc?'<div class="ft-sp-offer-more">'+md(moreSrc)+(slotMode()?'<div class="ft-sp-offer-cta"><button type="button" class="a" data-sheet="0">📝 Book a slot</button><button type="button" class="b" data-offerboard="1">View prices</button></div>':'')+'</div>':'';
    return'<div class="ft-sp-hero'+(o.open===true?' open':'')+'" id="ft-sp-offer"><div class="ft-sp-hero-top">'+
      (price?'<div class="ft-sp-bigp"><span>'+esc(price)+'</span><small>'+esc(note)+'</small></div>':'')+
      '<div class="ft-sp-hero-mid">'+(tx?'<div class="ft-sp-hero-t">'+tx+'</div>':'')+dots+'</div>'+
      (more?'<button type="button" class="ft-sp-offer-b" data-offer="1" data-show="'+esc(o.button||"Show more")+'" data-hide="Show less">'+esc(o.open===true?"Show less":(o.button||"Show more"))+'</button>':'')+'</div>'+more+'</div>';
  }
  function slotMode(){return !!(rateCard&&Array.isArray(rateCard.positions)&&rateCard.positions.length)}
  // order in the panel (slot mode): 1) booked slots by position  2) your ad (always)  3) "Advertise here" cards for the vacant positions
  function cardsHtml(){
    if(!slotMode())return offerHtml()+items.map(renderItem).join("");
    var v=rateCard.vacant||{},paid="",vac=[],adH="",msgH="";
    for(var n=1;n<=Math.min(5,rateCard.positions.length);n++){
      // every running booking of this position (one per size), already sorted Large > Medium > Small
      items.forEach(function(it){if(parseInt(it.position,10)===n)paid+=renderItem(it)});
      if(posStats(n).free>0)vac.push(n)}          // an "Advertise here" card for every position that still has a free size
    if(v.html)for(var k=0;k<(parseInt(v.maxAds,10)||1);k++)
      adH+=renderItem({__i:-1,id:"vacant-ad-"+k,label:v.label||"Ad",html:v.html,height:v.height,sameOrigin:v.sameOrigin===true,background:v.background});
    msgH=vac.map(vacantMsg).join("");
    var extra="";items.forEach(function(x){if(!(parseInt(x.position,10)>=1)&&x.extra===true)extra+=renderItem(x)});   // "extra":true = also show a non-slot entry
    return offerHtml()+paid+adH+msgH+extra;
  }
  function render(){
    var body=panel.querySelector(".ft-sp-body");
    body.innerHTML=((items&&items.length)||slotMode())?cardsHtml()+renderRates(rateCard,items)+(footer?'<div class="ft-sp-foot">'+esc(footer)+(contactInfo().em?' <a href="mailto:'+esc(contactInfo().em)+'?subject='+esc(encodeURIComponent("Report an ad on FreeTV Garden"))+'">Report an ad</a>':'')+'</div>':""):'<div class="ft-sp-empty">No sponsored content right now.</div>';
    if(!PAGE)body.scrollTop=0;
    var ab=panel.querySelector("#ft-sp-adv");if(ab){var has=!!(rateCard&&((rateCard.positions&&rateCard.positions.length)||(rateCard.slots&&rateCard.slots.length)));ab.classList.toggle("show",has);ab.textContent="📣 "+((rateCard&&rateCard.headButton)||"Advertise")}
  }

  /* ---------------- unread dot ---------------- */
  function signature(){return(items||[]).map(function(i){return i.id||i.__i}).join("|")+(slotMode()?"|slots":"")}
  function updateDot(){var n=!!((items&&items.length)||slotMode())&&lsGet(SEEN_KEY)!==signature();
    if(btn)btn.classList.toggle("ft-sp-new",n);if(barBtn)barBtn.classList.toggle("ft-sp-new",n)}

  /* ---------------- open / close ---------------- */
  function build(){
    panel=document.createElement("div");panel.id="ft-sp-panel";
    panel.setAttribute("role","dialog");panel.setAttribute("aria-label","Sponsored");
    panel.innerHTML='<div class="ft-sp-head"><div class="ft-sp-title">📢 Sponsored</div><button type="button" class="ft-sp-cur" id="ft-sp-cur" title="Change currency"></button><button type="button" class="ft-sp-adv" id="ft-sp-adv">📣 Advertise</button><button class="ft-sp-x" id="ft-sp-close" aria-label="Close">✕</button></div><div class="ft-sp-body"></div><div class="ft-sp-sheet" id="ft-sp-sheet" role="dialog" aria-modal="true" aria-label="Book an ad slot"></div>';
    (PAGE?document.getElementById("sp-root"):document.body).appendChild(panel);
    panel.querySelector("#ft-sp-close").onclick=close;
    var curB=panel.querySelector("#ft-sp-cur");
    function curLabel(){curB.textContent=curMode==="USD"?"$ USD":"₹ INR"}
    curLabel();
    curB.onclick=function(){curMode=curMode==="USD"?"INR":"USD";try{localStorage.setItem("ft-sp-cur",curMode)}catch(e){}
      curLabel();if(lastJson)applyJson(lastJson);render();if(sheetOpen())renderSheet();track("sponsored_currency",curMode)};   // FIX: popup prices refresh too
    // count clicks on links, buttons and banners (GA4 event sponsored_click)
    panel.addEventListener("input",function(e){var t=e.target;
      if(t.id==="ft-sh-start"){var mn=minStart(sh.pos,sh.size);sh.start=(t.value&&t.value>=mn)?t.value:mn}
      else if(t.id==="ft-sh-days"){var dv=parseInt(t.value,10);sh.days=dv>=1?Math.min(maxDaysAllowed(),dv):1;if(dv>sh.days)t.value=sh.days}else if(t.id==="ft-sh-link")sh.link=t.value.trim();else if(t.id==="ft-sh-note")sh.note=t.value.trim();
      else if(t.id==="ft-sh-title")sh.title=t.value.trim();else if(t.id==="ft-sh-adtext")sh.adText=t.value.trim().replace(/\s*\n\s*/g," ");
      else if(t.id==="ft-sh-img")sh.img=t.value.trim();else if(t.id==="ft-sh-contact")sh.contact=t.value.trim();else return;
      updateSheetSummary()});
    panel.addEventListener("click",function(e){
      var ofB=e.target.closest&&e.target.closest("[data-offer]");
      if(ofB){var ob=ofB.closest(".ft-sp-hero"),oo=ob.classList.toggle("open");ofB.textContent=oo?ofB.getAttribute("data-hide"):ofB.getAttribute("data-show");if(oo)track("sponsored_offer_expand","");return}
      var ofV=e.target.closest&&e.target.closest("[data-offerboard]");
      if(ofV){var rc3=panel.querySelector("#ft-sp-rates");if(rc3){rc3.classList.add("open");var rt3=rc3.querySelector("[data-rates]");if(rt3)rt3.textContent=rt3.getAttribute("data-hide");rc3.scrollIntoView({behavior:"smooth",block:"start"})}return}
      var shX=e.target.closest&&e.target.closest("[data-shclose]");
      if(shX){closeSheet();return}
      var chB=e.target.closest&&e.target.closest("[data-sh]");
      if(chB&&!chB.disabled){var k=chB.getAttribute("data-sh"),v=chB.getAttribute("data-v");
        if(k==="pos"){sh.pos=parseInt(v,10);sh.start="";sh.size=bookable(sh.pos,sh.size)?sh.size:bestSize(sh.pos)}else if(k==="size"){sh.size=v;sh.start=""}else if(k==="days"){sh.days=parseInt(v,10);sh.custom=false}else if(k==="custom"){sh.custom=true;if(!(sh.days>=1))sh.days=1}
        renderSheet();return}
      var cpm=e.target.closest&&e.target.closest("[data-copymsg]");
      if(cpm){var tx=bookingMsg().text,dn=function(){var t0=cpm.textContent;cpm.textContent="Copied ✓";setTimeout(function(){cpm.textContent=t0},1500)};
        try{navigator.clipboard.writeText(tx).then(dn,dn)}catch(x){try{var ta=document.createElement("textarea");ta.value=tx;ta.style.cssText="position:fixed;opacity:0";document.body.appendChild(ta);ta.select();document.execCommand("copy");document.body.removeChild(ta);dn()}catch(y){}}
        track("sponsored_copy_request","",{position:String(sh.pos)});return}
      var shB=e.target.closest&&e.target.closest("[data-sheet]");
      if(shB){openSheet(parseInt(shB.getAttribute("data-sheet"),10)||0,shB.getAttribute("data-size")||"");return}
      var stB=e.target.closest&&e.target.closest("[data-strip]");
      if(stB){var sn=parseInt(stB.getAttribute("data-strip"),10);
        if(posStats(sn).free>0){openSheet(sn)}else{var cardEl=panel.querySelector('[data-slot="'+sn+'"]');if(cardEl)cardEl.scrollIntoView({behavior:"smooth",block:"center"});else openSheet(sn)}
        return}
      var bdA=e.target.closest&&e.target.closest('a[href="#board"]');
      if(bdA){e.preventDefault();var vid=bdA.closest(".ft-sp-item")?bdA.closest(".ft-sp-item").getAttribute("data-id"):"",vm=String(vid).match(/vacant-(\d)/);track("sponsored_vacant_click",vid);openSheet(vm?parseInt(vm[1],10):0);return}
      var advB=e.target.closest&&e.target.closest("#ft-sp-adv");
      if(advB){var rc=panel.querySelector("#ft-sp-rates");if(rc){rc.classList.add("open");var rt=rc.querySelector("[data-rates]");if(rt)rt.textContent=rt.getAttribute("data-hide");rc.scrollIntoView({behavior:"smooth",block:"start"})}track("sponsored_advertise_click","");return}
      var gt=e.target.closest&&e.target.closest(".ft-sp-gtog");
      if(gt){var gd=gt.nextElementSibling,go=gd.classList.toggle("open");gt.textContent=go?gt.getAttribute("data-hide"):gt.getAttribute("data-show");return}
      var bn=e.target.closest&&e.target.closest(".ft-sp-booknow");
      if(bn){var bo=bn.nextElementSibling;bo.classList.toggle("open");track("sponsored_booknow_click","",{position:bn.getAttribute("data-pos")});return}
      var bkA=e.target.closest&&e.target.closest("a.ft-sp-bkrow");
      if(bkA){track("sponsored_book_click","",{position:bkA.getAttribute("data-pos"),via:bkA.getAttribute("data-via")});return}
      var tg=e.target.closest&&e.target.closest(".ft-sp-tog,.ft-sp-copy");
      if(tg){var bx=tg.closest(".ft-sp-item,.ft-sp-rates"),id=bx&&bx.getAttribute("data-id");
        if(tg.getAttribute("data-rates")){var ro=bx.classList.toggle("open");tg.textContent=ro?tg.getAttribute("data-hide"):tg.getAttribute("data-show");if(ro)track("sponsored_rates_open","");return}
        if(tg.classList.contains("ft-sp-tog")){var o=bx.classList.toggle("open");tg.textContent=o?tg.getAttribute("data-hide"):tg.getAttribute("data-show");if(o)track("sponsored_expand",id)}
        else{var v=tg.getAttribute("data-copy"),done=function(){var t=tg.textContent;tg.textContent="Copied ✓";setTimeout(function(){tg.textContent=t},1400)};
          try{navigator.clipboard.writeText(v).then(done,done)}catch(x){try{var ta=document.createElement("textarea");ta.value=v;ta.style.cssText="position:fixed;opacity:0";document.body.appendChild(ta);ta.select();document.execCommand("copy");document.body.removeChild(ta);done()}catch(y){}}
          track("sponsored_copy",id)}
        return}
      var a=e.target.closest&&e.target.closest("a[href]"),box=a&&a.closest(".ft-sp-item");
      if(!box)return;
      var kind=a.classList.contains("ft-sp-rowlink")?"row":a.classList.contains("ft-sp-contact-link")?"contact":a.classList.contains("ft-sp-btn")?"button":(a.classList.contains("ft-sp-imglink")?"image":"text_link");
      track("sponsored_click",box.getAttribute("data-id"),{click_type:kind,link_domain:domainOf(a.getAttribute("href"))});
    });
  }
  function open(){
    if(!panel)build();
    // make sure the Recent/Favourites list and the notices/language panels are not open underneath
    try{var rf=document.getElementById("ft-rf-overlay");if(rf&&rf.classList.contains("open"))document.getElementById("ft-rf-close").click()}catch(e){}
    try{var n=document.getElementById("ft-notif-panel");if(n&&n.classList.contains("open"))document.getElementById("ft-notif-close").click()}catch(e){}
    try{var l=document.getElementById("ft-lang-panel");if(l&&l.classList.contains("open"))document.getElementById("ft-lang-close").click()}catch(e){}
    ["ft-rf-tab-recent","ft-rf-tab-fav"].forEach(function(id){var b=document.getElementById(id);if(b)b.classList.remove("active")});
    render();panel.classList.add("open");if(btn)btn.classList.add("active");if(barBtn)barBtn.classList.add("active");
    lsSet(SEEN_KEY,signature());updateDot();
    track("sponsored_open","",{item_count:(items||[]).length});          // GA4: how many times the panel was opened
    clearInterval(cdTimer);cdTimer=setInterval(function(){tickCountdowns();expireCheck()},20000);   // refresh countdown chips every 20s while open
    watchViews();                                                          // GA4: sponsored_view per entry, when scrolled into sight
    // quietly refresh if the data is old (a new ad you just committed shows without a page reload)
    if(Date.now()-loadedAt>STALE_MS)load().then(function(){if(panel.classList.contains("open"))render()});
  }
  /* sponsored_view = an entry was actually visible (>=50%) in the panel. Counted once per entry per opening. */
  var viewObs=null;
  function watchViews(){
    try{
      if(viewObs)viewObs.disconnect();
      var els=panel.querySelectorAll(".ft-sp-item");
      if(!("IntersectionObserver" in window)){Array.prototype.forEach.call(els,function(el){track("sponsored_view",el.getAttribute("data-id"))});return}
      viewObs=new IntersectionObserver(function(es){es.forEach(function(en){
        if(en.isIntersecting){track("sponsored_view",en.target.getAttribute("data-id"));viewObs.unobserve(en.target)}})},{root:PAGE?null:panel.querySelector(".ft-sp-body"),threshold:.5});
      Array.prototype.forEach.call(els,function(el){viewObs.observe(el)});
    }catch(e){}
  }
  /* CLICKS INSIDE AN HTML AD: the browser hides what happens inside an ad iframe, but when someone taps/clicks it,
     the page loses focus and the iframe becomes the "active element". We count that as a click on that ad. */
  window.addEventListener("blur",function(){setTimeout(function(){
    try{var a=document.activeElement;
      if(a&&a.classList&&a.classList.contains("ft-sp-frame")){
        var box=a.closest(".ft-sp-item");if(box)track("sponsored_click",box.getAttribute("data-id"),{click_type:"html_ad"});
        setTimeout(function(){try{window.focus()}catch(e){}},0)}   // take focus back so the NEXT click is counted too
    }catch(e){}},0)});
  function close(){if(PAGE){closeSheet();return}clearInterval(cdTimer);closeSheet();if(viewObs){viewObs.disconnect()}if(panel){panel.classList.remove("open");
    // empty the panel so ad iframes stop running while it is hidden
    var b=panel.querySelector(".ft-sp-body");if(b)b.innerHTML=""}
    if(btn)btn.classList.remove("active");if(barBtn)barBtn.classList.remove("active")}
  function expireCheck(){try{
    if(!lastJson||!panel||!panel.classList.contains("open"))return;
    var n=Date.now();
    if((items||[]).some(function(it){var e=parseDate(it.end,true);return e!==null&&e<n})){applyJson(lastJson);render();watchViews()}   // something expired: rebuild without it
  }catch(e){}}
  document.addEventListener("visibilitychange",function(){if(!document.hidden)expireCheck()});
  function isOpen(){return !!(panel&&panel.classList.contains("open"))}

  /* ---------------- create the pill (only when there is something to show) ---------------- */
  function addButton(){
    if(btn||!items||!(items.length||slotMode()))return;
    /* anchor = the Favourites pill: the Sponsored pill goes RIGHT AFTER it (falls back to Recent if Favourites is missing) */
    var fav=document.getElementById("ft-rf-tab-fav"),recent=fav||document.getElementById("ft-rf-tab-recent");
    if(!recent||!recent.parentNode)return;
    btn=document.createElement("button");
    btn.className="ft-rf-tab";btn.id="ft-sp-tab";btn.type="button";
    btn.innerHTML='📢 Sponsored<span class="ft-sp-dot"></span>';
    recent.parentNode.insertBefore(btn,fav?recent.nextSibling:recent);   // <- placed AFTER Favourites
    btn.addEventListener("click",function(){isOpen()?close():open()});
    updateDot();
  }
  /* icon-only button in the player bar: placed right after the favourite star (found by id/class/text/label containing
     epg / guide / schedule). If no EPG button is found it goes just before the report-flag icon, or at the end. */
  function placeBarBtn(){
    try{
      var bar=document.querySelector(".now-playing-bar");
      if(!bar||!items||!(items.length||slotMode()))return;
      if(!barBtn){
        barBtn=document.createElement("button");barBtn.id="ft-sp-bar";barBtn.type="button";
        barBtn.title="Sponsored";barBtn.setAttribute("aria-label","Sponsored");
        // megaphone + $ coin icon, no text (own drawing)
        barBtn.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.5" cy="12" r="6"/><path d="M7.5 8.2v7.6M9.6 9.7c-.4-.8-1.1-1.1-2.1-1.1-1.2 0-2 .6-2 1.5s.8 1.3 2 1.5 2 .6 2 1.6-.8 1.5-2 1.5c-1 0-1.8-.4-2.2-1.2"/><path d="M14.2 9l5.8-3.4v12.8L14.2 15"/><path d="M22.3 10v4"/></svg><span class="ft-sp-dot"></span>';
        barBtn.addEventListener("click",function(e){e.stopPropagation();isOpen()?close():open()});   // stopPropagation: the bar is draggable
        updateDot();
      }
      /* put the icon right AFTER the favourite star (#np-fav-star). If the star is not there yet, fall back to
         "after the EPG button", then "before the report flag", then the end of the bar. */
      var anchor=document.getElementById("np-fav-star");
      if(!anchor||!bar.contains(anchor)){
        [].some.call(bar.querySelectorAll("button,a,div,span"),function(n){
          if(n===barBtn||barBtn.contains(n))return false;
          var t=((n.id||"")+" "+(n.getAttribute("aria-label")||"")+" "+(n.title||"")+" "+((n.children.length?"":n.textContent)||"")).toLowerCase();
          if(/epg|guide|schedule/.test(t)){anchor=n;return true}return false})}
      while(anchor&&anchor.parentNode!==bar)anchor=anchor.parentNode;   // climb to the bar's direct child
      if(anchor){if(anchor.nextSibling!==barBtn)bar.insertBefore(barBtn,anchor.nextSibling)}
      else{var rp=document.getElementById("ft-report-btn");
        if(rp&&rp.parentNode===bar){if(barBtn.nextSibling!==rp)bar.insertBefore(barBtn,rp)}
        else if(barBtn.parentNode!==bar)bar.appendChild(barBtn)}
    }catch(e){}
  }
  function watchBar(){
    placeBarBtn();
    try{var bar=document.querySelector(".now-playing-bar");
      if(bar&&window.MutationObserver){var busy=false;new MutationObserver(function(){   // the EPG button can appear later / be rebuilt: keep us next to it
        if(busy)return;busy=true;setTimeout(function(){busy=false;placeBarBtn()},150)}).observe(bar,{childList:true})}}catch(e){}
  }

  // opening Recent / Favourites closes the sponsored panel
  document.addEventListener("click",function(e){
    var t=e.target&&e.target.closest&&e.target.closest("#ft-rf-tab-recent,#ft-rf-tab-fav");
    if(t&&isOpen())close();
  },true);
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&isOpen()){if(sheetOpen())closeSheet();else close()}});
  // FIX: click / tap OUTSIDE the booking popup closes it (buttons that open the popup are ignored)
  document.addEventListener("click",function(e){
    if(!sheetOpen())return;var t=e.target;if(!t||!t.closest)return;
    if(t.closest("#ft-sp-sheet")||t.closest("[data-sheet],[data-strip],a[href='#board']"))return;
    closeSheet();
  },true);
  // on a phone the notices bell / language picker open full-screen panels: close ours first
  document.addEventListener("click",function(e){
    if(isOpen()&&e.target.closest&&e.target.closest("#notif-btn,#btn-select-lang"))close();
  },true);

  /* ---------------- start AFTER the page has loaded and the browser is idle (no effect on load speed) ---------------- */
  function start(){load().then(function(){if(PAGE){open();return}addButton();watchBar()})}
  function whenIdle(){("requestIdleCallback"in window)?requestIdleCallback(start,{timeout:4000}):setTimeout(start,3000)}
  if(PAGE)start();   // standalone page: start right away
  else if(document.readyState==="complete")setTimeout(whenIdle,2500);
  else window.addEventListener("load",function(){setTimeout(whenIdle,2500)});
}catch(err){}})();
