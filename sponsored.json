    if(!pk&&endMs&&!it.__vac)metaParts=[priceTxt,cdLive?"":endTxt].filter(Boolean);
    var metaLine=esc(metaParts.join("  ·  "))+(cdSpan?(metaParts.length?"  ·  ":"")+cdSpan:"");
    var priceTag="";
