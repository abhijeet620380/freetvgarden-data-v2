    var sz=String(it.size||(it.pinned?"large":"medium")).toLowerCase();
    var szc=sz==="large"||sz==="l"?"l":(sz==="small"||sz==="s"?"s":"m");            // fixed card size: s / m / l
    var pos=Math.max(0,Math.min(5,parseInt(it.position,10)||0)),tier=TIERS[pos]||null;   // position 1-5 (1 = top)
    var pk=!!(pos||it.__pk)&&!it.html;       // paid slot (has a position): gets a FIXED size layout. Entries without a position keep the normal flexible card.
    // label colour: a preset name (green gold red blue purple orange gray silver bronze) or any hex colour
    var lc=String(it.labelColor||""),lcls="",lsty="";
