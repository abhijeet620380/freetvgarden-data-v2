  function closeSheet(){var el=panel&&panel.querySelector("#ft-sp-sheet");if(el)el.classList.remove("open");document.documentElement.classList.remove("ft-sp-lock")}
  function sheetOpen(){var el=panel&&panel.querySelector("#ft-sp-sheet");return !!(el&&el.classList.contains("open"))}
  // SLOT BOARD (top-level "rateCard" in sponsored.json). 5 positions x 3 sizes = 15 slots, each with its price.
  // A position is "BOOKED" automatically while an entry with that "position" is running (and FREE again when it ends).
  // Booked positions show "Next available from <date>" (end of the last booking in a row) with Telegram + Email booking buttons.
  // "reserved":[4] marks a position ON HOLD by hand. Old style rateCard with a plain "slots" list still works.
  function renderRates(r,list){
    if(!r||typeof r!=="object")return"";
    var open=r.open===true,title=esc(r.title||"Ad slots & prices"),bodyH="",sumH="",now=Date.now();
    if(Array.isArray(r.positions)&&r.positions.length){
      var hold={},freeN=0,total=Math.min(5,r.positions.length);
      (Array.isArray(r.reserved)?r.reserved:[]).forEach(function(n){hold[n]=1});
      var rows=r.positions.slice(0,5).map(function(x,i){x=x||{};var n=parseInt(x.n,10)||i+1,t=TIERS[n]||TIERS[5];
        var si=slotInfo(n),cur=si.cur,hd=si.hd,free=si.free,nextFree=si.nextFree,openEnded=si.openEnded,upcoming=si.upcoming;
        if(free)freeN++;
        var cells=[["small","S","SMALL"],["medium","M","MEDIUM"],["large","L","LARGE"]].map(function(c){
          return'<div class="ft-sp-pc '+(free?'ok':'no')+'"><i>'+c[1]+' · '+c[2]+'</i><b>'+esc(x[c[0]]||"—")+'</b><em>'+(free?'Vacant':(hd?'On hold':'Booked'))+'</em></div>'}).join("");
        var st=free?'<span class="ft-sp-st free">● AVAILABLE</span>':(hd?'<span class="ft-sp-st hold">ON HOLD</span>':'<span class="ft-sp-st taken">BOOKED</span>');
        var info="",bk="";
        if(free){bk=bookBtn(n,"Book now");if(upcoming)info='<div class="ft-sp-until">Free now · next booking starts '+esc(fmtDT(upcoming))+'</div>'}
        else if(cur){
          var runSz=/^l/.test(cur.size)?"Large":/^s/.test(cur.size)?"Small":cur.size?"Medium":"";
          info='<div class="ft-sp-until">'+(cur.e?'Booked until '+esc(fmtDT(cur.e)):'Booked (no end date)')+(runSz?' · running as a '+runSz+' card':'')+'</div>';
          if(nextFree){info+='<div class="ft-sp-next">📅 Next available from '+esc(fmtDT(nextFree))+'</div>';bk=bookBtn(n,"Book now for "+fmtDT(nextFree))}
          else if(openEnded){info+='<div class="ft-sp-next">Contact us for the next date</div>';bk=""}}
        else bk="";
        return'<div class="ft-sp-pos '+(free?'free':'taken')+'"><div class="ft-sp-pos-top"><span class="ft-sp-tag ft-sp-c-'+t.cls+'">'+(t.icon?t.icon+" ":"")+esc(x.tag||t.name)+'</span><span class="ft-sp-pos-name">'+esc(x.name||("Position "+n))+'</span>'+st+'</div><div class="ft-sp-prices">'+cells+'</div>'+info+bk+'</div>'}).join("");
      sumH=freeN?'<span class="ft-sp-sum ok">🟢 '+freeN+' of '+total+' positions available</span>':'<span class="ft-sp-sum full">🔴 All '+total+' positions booked</span>';
      // ACTUAL-SIZE PREVIEW of the three card sizes
      var sm=function(sz,extra){return renderItem(Object.assign({__i:-1,__sample:true,__pk:true,id:"sample-"+sz,label:"Promoted",size:sz,title:"Your title goes here",text:"A short line about your website, app, product or channel. Keep it clear and simple.",link:"/",button:"Visit",__ph:true,price:"₹59 / 24h",end:new Date(Date.now()+864e5).toISOString()},extra||{}))};
      var guide='<button type="button" class="ft-sp-gtog" data-show="📐 See the actual size of Small / Medium / Large" data-hide="Hide size preview">📐 See the actual size of Small / Medium / Large</button><div class="ft-sp-guide">'+
        '<div class="ft-sp-gcap"><b>SMALL</b> — compact list row, 96 px high: 64 px picture, all tags on top, 1-line title, 1 line of text, tap anywhere to open.</div>'+sm("small")+
        '<div class="ft-sp-gcap"><b>MEDIUM</b> — card 196 px high: picture on the left, title (2 lines), text (3 lines), small button.</div>'+sm("medium")+
