    h+='<button type="button" class="ft-sp-copy2" data-copymsg="1"'+(lock?' disabled style="opacity:.4;cursor:not-allowed"':'')+'>📋 Copy the message (to send anywhere)</button><div class="ft-sp-small-note">'+(m.free?'This is FREE – no payment needed. We confirm availability first.':'No payment now. We confirm availability and the final price first, then you pay.')+(rateCard&&rateCard.sheetNote&&!m.free?" "+esc(rateCard.sheetNote):"")+'</div>';
