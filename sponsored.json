/* sponsored.js - Sponsored tab (after Favourites), player icon (after the star) and the Sponsored panel for the HOMEPAGE.
   Data comes from sponsored.json in freetvgarden-data-v2. Upload to the site root. */
(function(){try{
  /* ---------------- SETTINGS (edit here if you ever move the file) ---------------- */
  var LIVE = "https://raw.githubusercontent.com/abhijeet620380/freetvgarden-data-v2/main/sponsored.json"; // live copy from your data repo
  var LOCAL = "/sponsored.json";      // fallback: a copy deployed with the site (optional - ignored if missing)
  var SEEN_KEY = "ft_sp_seen";        // localStorage key for the red "new" dot (per visitor, harmless if blocked)
  var MAX_ITEMS = 20;                 // never show more than this many entries
  var STALE_MS = 10*60*1000;          // re-fetch when the panel is opened and data is older than this

  var DEFAULT_FOOTER = "Sponsored content: FreeTV Garden may be paid for these placements. Links open the advertiser's own site, which we do not control.";
  var footer = DEFAULT_FOOTER, rateCard = null, offer = null;
  var PAGE = !!document.getElementById("sp-root");   // standalone page mode (panel is part of the page, always open)
  var items = null, loadedAt = 0, btn = null, barBtn = null, panel = null;

  /* ---------------- small helpers ---------------- */
  function esc(s){return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;")}
  // only http(s) links and same-site paths are allowed (blocks javascript: / data: URLs)
  function safeUrl(u){u=String(u||"").trim();return(u==="#board"||/^https?:\/\//i.test(u)||/^mailto:[^\s]+$/i.test(u)||/^\/(?!\/)/.test(u))?u:""}
  function lsGet(k){try{return localStorage.getItem(k)}catch(e){return null}}
  function lsSet(k,v){try{localStorage.setItem(k,v)}catch(e){}}
  /* ANALYTICS (GA4). Events are pushed to the same dataLayer your site's GA4 tag (G-F6S21CCQTW) already reads.
     Must push the "arguments" object (that is what gtag.js expects), so we use a tiny gtag-style function. */
  function ga(){try{window.dataLayer=window.dataLayer||[];window.dataLayer.push(arguments)}catch(e){}}
  function itemById(id){for(var i=0;i<(items||[]).length;i++){if(String(items[i].id||("i"+items[i].__i))===String(id))return items[i]}return null}
  function itemType(it){return it.html?"html_ad":(it.image&&!it.title&&!it.text?"image_banner":(it.image?"image_card":"text_card"))}
  function domainOf(u){try{return new URL(u,location.href).hostname}catch(e){return""}}
  // send one event. Always carries which entry it was about (id, title, type, position in the list).
  function track(name,id,extra){try{
    var it=itemById(id)||{},p={sponsor_id:String(id||""),sponsor_title:String(it.title||it.id||"").slice(0,80),
      sponsor_type:it.__i==null?"":itemType(it),sponsor_position:it.__i==null?0:(items.indexOf(it)+1),
      device:wide()?"pc":"phone"};
    for(var k in (extra||{}))p[k]=extra[k];
    ga("event",name,p)}catch(e){}}
  function wide(){return window.innerWidth>=769}

  // tiny safe "markdown": **bold**, *italic*, [text](https://link), blank line = new paragraph, single newline = <br>.
  // Everything is HTML-escaped FIRST, so text in the JSON can never inject HTML (use type "html" for that on purpose).
  function md(src){
    var s=esc(src);
    s=s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g,function(m,t,u){
      u=u.replace(/&amp;/g,"&");var ok=safeUrl(u);
      return ok?'<a href="'+esc(ok)+'" target="_blank" rel="sponsored nofollow noopener noreferrer">'+t+'</a>':t});
    s=s.replace(/\*\*([^*]+)\*\*/g,"<b>$1</b>").replace(/(^|[^*])\*([^*\n]+)\*/g,"$1<i>$2</i>");
    return s.split(/\n{2,}/).map(function(p){return"<p style='margin:0 0 8px'>"+p.replace(/\n/g,"<br>")+"</p>"}).join("");
  }

  /* ---------------- which entries are active right now ---------------- */
  // "start"/"end" accept "2026-11-01" or full ISO. An end DATE (no time) lasts the whole day.
  function parseDate(v,isEnd){if(!v)return null;var s=String(v).trim();
    if(/^\d{4}-\d{2}-\d{2}$/.test(s))s+=isEnd?"T23:59:59":"T00:00:00";
    var d=new Date(s);return isNaN(d)?null:d.getTime()}
  function active(it){
    if(!it||typeof it!=="object"||it.active===false)return false;
    var now=Date.now(),a=parseDate(it.start,false),b=parseDate(it.end,true);
    if(a!==null&&now<a)return false;
    if(b!==null&&now>b)return false;
    return !!(it.title||it.text||it.image||it.html);        // must have something to show
  }
  // SHORTHAND: "slot": "2S" / "1-large" / "3 medium" = position 2 small / position 1 large / ... (position, size, price are filled in for you)
  function applySlot(it){
    // price comes from the rateCard for ANY entry that has a position + size (so you never write prices in slots)
    if(!(typeof it.slot==="string"&&/^\s*[1-5]\s*[-_ ]?\s*(s|m|l|small|medium|large)\s*$/i.test(it.slot))){
      var pn=parseInt(it.position,10),ps=String(it.size||"").toLowerCase().charAt(0);
      if(pn>=1&&pn<=5&&ps&&"sml".indexOf(ps)>=0)it.price=priceFor(pn,ps==="s"?"small":ps==="m"?"medium":"large",true)||it.price;
      return it}
    var m=typeof it.slot==="string"&&it.slot.match(/^\s*([1-5])\s*[-_ ]?\s*(s|m|l|small|medium|large)\s*$/i);
    if(!m)return it;
    var n=+m[1],sz=m[2].toLowerCase().charAt(0),name=sz==="s"?"small":sz==="m"?"medium":"large";
    if(!it.position)it.position=n;
    if(!it.size)it.size=name;
    it.price=priceFor(n,name,true)||it.price;
    it.slot="Position "+n+" · "+name.charAt(0).toUpperCase()+name.slice(1);
    return it;
  }
  /* ================= SLOT MODEL (NEW) =================
     A "slot" = ONE position + ONE size, written like 1L, 1M, 1S, 2L ... 5S  (5 positions x 3 sizes = 15 slots).
     Every slot is booked on its own: booking 1L does NOT block 1M or 1S.
       rateCard.reserved : ["2M","4"]  = put slots on hold by hand (a plain number = all 3 sizes of that position)
       rateCard.closed   : ["5L","1S"] = switch slots OFF (not for sale, shown as "Not available")
       rateCard.free     : {"on":true,"until":"2027-02-28","maxDays":7,"badge":"..."}  = FREE period (see sponsored.json) */
  function szName(x){x=String(x||"medium").toLowerCase().charAt(0);return x==="s"?"small":x==="l"?"large":"medium"}
  function szRank(x){x=szName(x);return x==="large"?0:x==="medium"?1:2}          // inside a position: Large first, then Medium, then Small
  function szCap(x){x=szName(x);return x.charAt(0).toUpperCase()+x.slice(1)}
  function codeOf(n,size){return n+szName(size).charAt(0).toUpperCase()}
  function listHas(list,n,size){                                                    // list holds codes ("2M") or plain numbers (= whole position)
    if(!Array.isArray(list))return false;var c=codeOf(n,size);
    return list.some(function(k){k=String(k).trim().toUpperCase();return k===c||k===String(n)})}
  function fmtD(ms){return new Date(ms).toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"})}
  // FREE PERIOD: returns null when it is off or its "until" date has passed (prices and normal booking come back by themselves)
  function freeInfo(){
    var f=rateCard&&rateCard.free;if(!f||typeof f!=="object"||f.on!==true)return null;
    var u=f.until?parseDate(f.until,true):null;if(u!==null&&Date.now()>u)return null;
    return{until:u,maxDays:Math.max(0,parseInt(f.maxDays,10)||0),badge:f.badge||"",more:f.more||"",note:f.note||""}}
  function maxDaysAllowed(){var f=freeInfo();return f&&f.maxDays>0?f.maxDays:365}
  // price of a slot from the rateCard table ("₹59" + " / 24h"). During the FREE period it is simply "FREE".
  function priceFor(n,name,forItem){
    if(!rateCard||!Array.isArray(rateCard.positions))return"";
    if(freeInfo())return forItem?"":"FREE";      // a running ad shows no price chip during the free period; vacant cards say FREE
    for(var i=0;i<rateCard.positions.length;i++){var x=rateCard.positions[i]||{};
      if((parseInt(x.n,10)||i+1)===n&&x[name])return x[name]+(rateCard.priceSuffix!==undefined?rateCard.priceSuffix:" / 24h")}
    return"";
  }
  var windows=[];     // every booking window (also future ones): used by the slot board for "next available date"
  function normalise(json){
    var list=Array.isArray(json)?json:(json&&Array.isArray(json.items)?json.items:[]);
    list=list.map(function(it,i){it=applySlot(it||{});it.__i=i;return it});
    windows=list.filter(function(it){return it.active!==false&&parseInt(it.position,10)>=1&&parseInt(it.position,10)<=5})
      .map(function(it){return{n:parseInt(it.position,10),s:parseDate(it.start,false),e:parseDate(it.end,true),size:szName(it.size||(it.pinned?"large":"medium"))}});
    return list.filter(active)
      .sort(function(a,b){return(+a.position||99)-(+b.position||99)||szRank(a.size)-szRank(b.size)||(b.pinned?1:0)-(a.pinned?1:0)||(+b.priority||0)-(+a.priority||0)||a.__i-b.__i})
      .slice(0,MAX_ITEMS);
  }

  /* ---------------- fetch (live GitHub copy first, then the deployed copy) ---------------- */
  function getJson(){
    return fetch(LIVE,{cache:"no-cache",signal:AbortSignal.timeout(8000)})
      .then(function(r){if(!r.ok)throw 0;return r.json()})
      .catch(function(){return fetch(LOCAL,{cache:"no-cache",signal:AbortSignal.timeout(8000)})
        .then(function(r){if(!r.ok)throw 0;return r.json()})});
  }
  // ---- CURRENCY: prices in sponsored.json are written in INR (e.g. "₹79"). Visitors outside India see USD automatically
  // (can switch with the ₹/$ button in the panel header). USD price = INR x factor, rounded up, never below "min".
  // Override in rateCard: "usd":{"symbol":"$","factor":0.05,"min":2}  and per position "usd":{"small":2,"medium":3,"large":4}
  var lastJson=null,curMode="INR";
  try{curMode=localStorage.getItem("ft-sp-cur")||""}catch(e){}
  if(curMode!=="INR"&&curMode!=="USD"){var tz="";try{tz=Intl.DateTimeFormat().resolvedOptions().timeZone||""}catch(e){}
    curMode=/^Asia\/(Kolkata|Calcutta)$/.test(tz)?"INR":"USD"}
  function toUsdRC(rc){   // returns a converted copy of the rate card (original is untouched)
    var c=JSON.parse(JSON.stringify(rc)),u=c.usd||{},sym=u.symbol||"$",f=parseFloat(u.factor)||0,mn=parseFloat(u.min);if(!(mn>=0))mn=0;var mx=parseFloat(u.max);if(!(mx>0))mx=1e9;
    (c.positions||[]).forEach(function(x){["small","medium","large"].forEach(function(k){
      if(x.usd&&x.usd[k]!==undefined){x[k]=sym+x.usd[k];return}
      if(!f)return;   // no factor in JSON = keep the written price; USD comes only from the explicit per-slot "usd" values
      var m=String(x[k]||"").match(/(\d[\d.,]*)/);if(!m)return;
      x[k]=sym+Math.min(mx,Math.max(mn,Math.ceil(parseFloat(m[1].replace(/,/g,""))*f)))})});
    return c}
  function applyJson(j){
    if(j&&!Array.isArray(j)&&j.enabled===false)j={items:[]};
    var rc=(j&&!Array.isArray(j)&&j.rateCard&&typeof j.rateCard==="object")?j.rateCard:null;
    rateCard=(rc&&curMode==="USD")?toUsdRC(rc):rc;
    offer=(j&&!Array.isArray(j)&&j.offer!==undefined)?j.offer:null;
    if(curMode==="USD"&&offer&&typeof offer==="object"){offer=Object.assign({},offer);if(offer.priceUSD)offer.price=offer.priceUSD;else delete offer.price}   // price auto = lowest USD price
    if(PAGE&&window.innerWidth>=900){if(offer&&typeof offer==="object"&&offer.open===undefined)offer=Object.assign({},offer,{open:true});if(rateCard)rateCard=Object.assign({},rateCard,{open:true})}
    items=normalise(j);footer=(j&&!Array.isArray(j)&&typeof j.footer==="string")?j.footer:DEFAULT_FOOTER;loadedAt=Date.now();return items}
  function load(){
    return getJson().then(function(j){lastJson=j;return applyJson(j)})
      .catch(function(){items=items||[];return items});
  }

  /* ---------------- render ---------------- */
  // contact rows: [{label:"EMAIL TO BOOK", value:"you@mail.com", link:"mailto:you@mail.com", button:"Email", copy:true}]
  function renderContacts(list){
    if(!Array.isArray(list)||!list.length)return"";
    return'<div class="ft-sp-contacts">'+list.slice(0,6).map(function(c){
      c=c||{};var l=safeUrl(c.link),v=String(c.value||"");
      return'<div class="ft-sp-contact"><div class="ft-sp-ct"><div class="ft-sp-cl">'+esc(c.label||"")+'</div><div class="ft-sp-cv">'+esc(v)+'</div></div>'+
        (c.copy&&v?'<button type="button" class="ft-sp-cb ft-sp-copy" data-copy="'+esc(v)+'">Copy</button>':"")+
        (l?'<a class="ft-sp-cb fill ft-sp-contact-link" href="'+esc(l)+'" target="_blank" rel="noopener noreferrer">'+esc(c.button||"Open")+'</a>':"")+'</div>'}).join("")+'</div>'}
  // "2d 5h" / "5h 12m" / "12m" / "less than a minute"
  function leftText(ms){
    if(ms<60000)return"Ends in under a minute";
    var m=Math.floor(ms/60000),d=Math.floor(m/1440),h=Math.floor(m%1440/60),mm=m%60;
    return"Ends in "+(d?d+"d "+h+"h":h?h+"h "+mm+"m":mm+"m");
  }
  // position 1-5 -> look. 1 = gold TOP, 2 = silver, 3 = bronze (these three get the special big cards), 4-5 = standard
  var TIERS={1:{icon:"👑",name:"#1 PREMIUM",cls:"gold",hex:"#d4a017"},2:{icon:"💎",name:"#2 PLATINUM",cls:"platinum",hex:"#b8c2d3"},3:{icon:"✨",name:"#3 PREMIUM",cls:"bronze",hex:"#c27a45"},4:{icon:"",name:"#4",cls:"blue",hex:"#64b5ff"},5:{icon:"",name:"#5",cls:"gray",hex:"#c7c7cc"}};
  var cdTimer=null;
  function tickCountdowns(){
    try{if(!panel)return;
      Array.prototype.forEach.call(panel.querySelectorAll(".ft-sp-cd"),function(c){
        var left=(+c.getAttribute("data-end"))-Date.now();
        if(left<=0){var box=c.closest(".ft-sp-item");if(box)box.parentNode.removeChild(box)}   // campaign finished: remove the card
        else c.textContent="⏳ "+leftText(left)})}catch(e){}
  }
  // ---- helpers for the slot board ----
  function fmtDT(ms){return new Date(ms).toLocaleString(undefined,{day:"numeric",month:"short",hour:"numeric",minute:"2-digit"})}
  // status of ONE slot (position + size): booked now? on hold? switched off? when is it next free?
  function slotInfo(n,size){
    size=szName(size);var now=Date.now();
    var ws=windows.filter(function(w){return w.n===n&&w.size===size}),cur=null;
    ws.forEach(function(w){if(!cur&&(w.s===null||w.s<=now)&&(w.e===null||w.e>=now))cur=w});
    var closed=listHas(rateCard&&rateCard.closed,n,size),
        hd=!cur&&!closed&&listHas(rateCard&&rateCard.reserved,n,size),
        free=!cur&&!hd&&!closed,nextFree=null,openEnded=false;
    if(cur){if(cur.e===null)openEnded=true;else{nextFree=cur.e;for(var k=0;k<12;k++){var nx=null;
        ws.forEach(function(w){if(w!==cur&&w.s!==null&&w.s<=nextFree+120000&&(w.e===null||w.e>nextFree)&&(!nx||(w.e===null||(nx.e!==null&&w.e>nx.e))))nx=w});
        if(!nx)break;if(nx.e===null){openEnded=true;nextFree=null;break}nextFree=nx.e}}}
    var upcoming=null;if(free)ws.forEach(function(w){if(w.s!==null&&w.s>now&&(!upcoming||w.s<upcoming))upcoming=w.s});
    return{cur:cur,hd:hd,closed:closed,free:free,nextFree:nextFree,openEnded:openEnded,upcoming:upcoming,size:size};
  }
  var SIZES=["small","medium","large"];
  function bookable(n,size){var i=slotInfo(n,size);return !i.closed&&!i.hd&&!i.openEnded}   // can be requested now or for a later date
  // how many of this position's slots are free now / are on sale at all
  function posStats(n){var f=0,o=0;SIZES.forEach(function(z){var i=slotInfo(n,z);if(!i.closed){o++;if(i.free)f++}});return{free:f,open:o}}
  // best size to pre-select: a free one (Medium first), else the one that frees up soonest
  function bestSize(n){
    var pref=["medium","large","small"],z,i;
    for(i=0;i<3;i++){z=pref[i];if(slotInfo(n,z).free)return z}
    var best=null,bt=1e18;pref.forEach(function(z){var si=slotInfo(n,z);if(bookable(n,z)&&si.nextFree&&si.nextFree<bt){bt=si.nextFree;best=z}});
    return best||"medium"}
  function bookBtn(n,label,size){return'<button type="button" class="ft-sp-booknow" data-sheet="'+n+'"'+(size?' data-size="'+szName(size)+'"':'')+'>'+esc(label)+'</button>'}
  // contacts: email address + telegram link/@id from the rateCard
  function contactInfo(){
    var r=rateCard||{},tg=safeUrl(r.bookTelegram||""),em=String(r.bookEmail||"").replace(/^mailto:/i,"").trim(),bl=safeUrl(r.bookLink||"");
    if(!tg&&!em&&bl){if(/^mailto:/i.test(bl))em=bl.replace(/^mailto:/i,"").split("?")[0];else tg=bl}
    if(!/^[^\s@<>"]+@[^\s@<>"]+$/.test(em))em="";
    return{em:em,tg:tg,handle:r.telegramHandle||(tg?"@"+tg.replace(/[?#].*$/,"").replace(/\/+$/,"").split("/").pop():"")};
  }
  // "₹59" -> {pre:"₹",n:59}; used to work out totals
  function money(str){var m=String(str||"").match(/^([^\d]*)(\d[\d.,]*)/);return m?{pre:m[1],n:parseFloat(m[2].replace(/,/g,""))}:null}
  function fmtMoney(mo,v){v=Math.round(v*100)/100;return mo.pre+(v%1?v.toFixed(2):String(v))}
  function isoDate(ms){var d=new Date(ms);return d.getFullYear()+"-"+("0"+(d.getMonth()+1)).slice(-2)+"-"+("0"+d.getDate()).slice(-2)}
  var sh={pos:1,size:"medium",days:1,custom:false,start:"",link:"",note:"",title:"",adText:"",img:"",contact:""};   // FORM: title/adText/img/contact added
  function durations(){var d=rateCard&&Array.isArray(rateCard.durations)&&rateCard.durations.length?rateCard.durations:[{days:1},{days:3},{days:7},{days:30}];
    var fi=freeInfo(),mx=maxDaysAllowed();
    var out=d.slice(0,6).map(function(x){x=x||{};var n=Math.max(1,parseInt(x.days,10)||1);return{days:n,off:fi?0:Math.max(0,Math.min(90,+x.off||0)),label:x.label||(n+(n===1?" day":" days"))}});
    if(fi&&fi.maxDays>0){out=out.filter(function(z){return z.days<=mx});if(!out.length)out=[{days:mx,off:0,label:mx+(mx===1?" day":" days")}]}
    return out}
  function minStart(n,size){var si=slotInfo(n,size);return si.nextFree?isoDate(si.nextFree):isoDate(Date.now())}
  function posRow(n){var P=rateCard&&rateCard.positions||[];for(var i=0;i<P.length;i++){if((parseInt(P[i].n,10)||i+1)===n)return P[i]}return{}}
  function fixSize(){if(!bookable(sh.pos,sh.size)){sh.size=bestSize(sh.pos);sh.start=""}}   // never leave a booked / switched-off size selected
  function clampDays(){var mx=maxDaysAllowed();if(!(sh.days>=1))sh.days=1;if(sh.days>mx)sh.days=mx}
  function bookingMsg(){
    clampDays();
    var fi=freeInfo(),x=posRow(sh.pos),mo=money(x[sh.size]),du=sh.custom?{days:sh.days,off:fi?0:durations().filter(function(d){return d.days<=sh.days}).reduce(function(m,d){return Math.max(m,d.off||0)},0)}:(durations().filter(function(d){return d.days===sh.days})[0]||{days:sh.days,off:0}),
        start=new Date(sh.start+"T00:00:00"),end=new Date(start.getTime()+sh.days*864e5),
        dd=function(d){return d.toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"})},
        price=fi?"FREE":(mo?fmtMoney(mo,mo.n)+" / day":""),tot=fi?"FREE":(mo?fmtMoney(mo,mo.n*sh.days*(1-du.off/100)):"");
    var szN=szCap(sh.size);
    var lines=["Hi FreeTV Garden, I would like to book an ad slot:","• Slot: "+codeOf(sh.pos,sh.size)+" (Position #"+sh.pos+(x.name?" — "+String(x.name).replace(/^Position\s*\d+\s*[—-]\s*/i,""):"")+", "+szN+" card)",
      "• Duration: "+sh.days+(sh.days===1?" day":" days")+" ("+dd(start)+" to "+dd(end)+")"];
    if(fi)lines.push("• Price: FREE (launch offer"+(fi.until?" until "+fmtD(fi.until):"")+")");
    else if(mo)lines.push("• Price: "+price+" × "+sh.days+(du.off?" − "+du.off+"%":"")+" = "+tot);
    // all ad details go into one message, so no back-and-forth questions
    if(sh.title)lines.push("• Ad title: "+sh.title);
    if(sh.adText)lines.push("• Ad text: "+sh.adText);
    if(sh.link)lines.push("• Link (where the ad opens): "+sh.link);
    if(sh.img)lines.push("• Picture link: "+sh.img);
    if(sh.contact)lines.push("• Reach me at: "+sh.contact);
    if(sh.note)lines.push("• Notes: "+sh.note);
    lines.push(fi?"Please confirm availability.":"Please confirm availability and payment details.");
    return{text:lines.join("\n"),subject:"Ad booking: "+codeOf(sh.pos,sh.size)+" · "+szN+" · "+sh.days+(sh.days===1?" day":" days"),total:tot,price:price,start:dd(start),end:dd(end),off:du.off,free:!!fi};
  }
  // every field is OPTIONAL, so nothing is ever locked. (To make a field required again, push its name into this list.)
  function formMissing(){return []}
  function updateSheetSummary(){
    var el=panel&&panel.querySelector("#ft-sh-out");if(!el)return;
    var m=bookingMsg(),c=contactInfo(),h='<div class="ft-sp-sum2"><div><b>Slot '+esc(codeOf(sh.pos,sh.size))+'</b> · Position #'+sh.pos+' · '+esc(szCap(sh.size))+' card</div><div>'+sh.days+(sh.days===1?' day':' days')+': '+esc(m.start)+' → '+esc(m.end)+'</div>'+
      (m.free?'<div class="tot">Total: FREE 🎁</div>':(m.total?'<div>'+esc(m.price)+' × '+sh.days+(m.off?' − '+m.off+'%':'')+'</div><div class="tot">Total: '+esc(m.total)+'</div>':''))+'</div>';
    var miss=formMissing(),lock=miss.length>0;
    h+='<div class="ft-sp-bkcap">'+(lock?'Fill in the details above to unlock sending:':'Send your request – tap one:')+'</div>';
    if(lock)h+='<div class="ft-sp-small-note" style="color:#ffb340;margin:0 0 6px">Still needed: '+esc(miss.join(" · "))+'</div>';
