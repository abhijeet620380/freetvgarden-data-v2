      SIZES.forEach(function(z){var q=slotInfo(n,z);if(q.nextFree&&(soon===null||q.nextFree<soon))soon=q.nextFree});
      return'<button type="button" class="ft-sp-ch'+(sh.pos===n?' sel':'')+(any?'':' dis')+'" data-sh="pos" data-v="'+n+'"'+(any?'':' disabled')+'><b>'+(t.icon||"")+' #'+n+'</b><i>'+(ps.free?ps.free+' of '+ps.open+' free':(soon?'From '+esc(new Date(soon).toLocaleDateString(undefined,{day:"numeric",month:"short"})):'Not available'))+'</i></button>'}).join("")+'</div>';
    var x=posRow(sh.pos);
    // step 2: size. Each size is its own slot with its own status.
    h+='<div class="ft-sp-sh-l">2 · Choose a card size</div><div class="ft-sp-chs">'+[["small","Small","list row"],["medium","Medium","picture + text"],["large","Large","biggest"]].map(function(c){
      var si=slotInfo(sh.pos,c[0]),ok=bookable(sh.pos,c[0]),st=si.closed?'Not available':si.hd?'On hold':si.free?(fi?'FREE':esc(x[c[0]]||"—")+' / day')+' · '+c[2]:(si.nextFree?'Booked · free from '+esc(new Date(si.nextFree).toLocaleDateString(undefined,{day:"numeric",month:"short"})):'Booked');
      return'<button type="button" class="ft-sp-ch'+(sh.size===c[0]?' sel':'')+(ok?'':' dis')+'" data-sh="size" data-v="'+c[0]+'"'+(ok?'':' disabled')+'><b>'+c[1]+'</b><i>'+st+'</i></button>'}).join("")+'</div>';
    h+='<div class="ft-sp-sh-l">3 · How long?</div><div class="ft-sp-chs">'+durations().map(function(d){
      return'<button type="button" class="ft-sp-ch'+(!sh.custom&&sh.days===d.days?' sel':'')+'" data-sh="days" data-v="'+d.days+'"><b>'+esc(d.label)+'</b>'+(d.off?'<i>'+d.off+'% off</i>':'')+'</button>'}).join("")+
      '<button type="button" class="ft-sp-ch'+(sh.custom?' sel':'')+'" data-sh="custom" data-v="1"><b>✏️ Custom</b><i>'+(fi&&fi.maxDays?'up to '+fi.maxDays+' days':'any days')+'</i></button></div>'+
      (sh.custom?'<div style="font-size:.72rem;color:#9fc4f5;margin:8px 0 4px">Number of days (1 – '+maxDaysAllowed()+'):</div><input class="ft-sp-in" type="number" id="ft-sh-days" min="1" max="'+maxDaysAllowed()+'" step="1" inputmode="numeric" value="'+sh.days+'">':'');
    var mn=minStart(sh.pos,sh.size);if(!sh.start||sh.start<mn)sh.start=mn;
