    else if(/^#[0-9a-f]{3,8}$/i.test(lc))lsty=' style="color:'+lc+';border-color:'+lc+';background:'+lc+'26"';
    // accent colour for the heading + card border (preset or hex)
    var ac=String(it.color||""),acHex={green:"#32d74b",gold:"#ffd60a",red:"#ff6961",blue:"#64b5ff",purple:"#c9a0ff",orange:"#ffb340",gray:"#d1d1d6",silver:"#c7ccd6",platinum:"#cfd6e4",bronze:"#ff9f5a"};
    ac=acHex[ac.toLowerCase()]||(/^#[0-9a-f]{3,8}$/i.test(ac)?ac:"");
    var small=pk&&szc==="s";                       // small slots are a compact list row: label + tier in the badges, details in ONE line under the text
    var sizeName=szc==="s"?"Small":szc==="m"?"Medium":"Large";
    var chips=small?"":(Array.isArray(it.tags)?it.tags.slice(0,4):[]).map(function(t){return'<span class="ft-sp-chip">'+esc(t)+'</span>'}).join("");
    // EVERY SLOT SHOWS: price, size and end date.  (price comes from the rateCard table; vacant slots say "Available")
