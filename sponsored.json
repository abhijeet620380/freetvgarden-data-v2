<body>
<header class="sp-top">
  <a class="sp-logo" href="/" aria-label="FreeTV Garden home"><span class="logo-tv-box" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 2.8L12 6.2L16 2.8" stroke="#1c1c1e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><rect x="2" y="6.2" width="20" height="14.4" rx="2.6" stroke="#1c1c1e" stroke-width="2"/><path d="M10.2 10L15.2 13.2L10.2 16.4Z" fill="#1c1c1e"/></svg></span><span>FreeTV<span class="logo-suffix"> Garden</span></span></a>
