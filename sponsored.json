      var advB=e.target.closest&&e.target.closest("#ft-sp-adv");
      if(advB){var rc=panel.querySelector("#ft-sp-rates");if(rc){rc.classList.add("open");var rt=rc.querySelector("[data-rates]");if(rt)rt.textContent=rt.getAttribute("data-hide");rc.scrollIntoView({behavior:"smooth",block:"start"})}track("sponsored_advertise_click","");return}
