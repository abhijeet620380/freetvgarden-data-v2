      var rowIn=th+'<div class="ft-sp-rmain">'+badges+(it.title?'<div class="ft-sp-h"'+hStyle+'>'+esc(it.title)+'</div>':'')+(it.text?'<div class="ft-sp-t ft-sp-tx">'+md(it.text)+'</div>':'')+'</div>'+(link?'<span class="ft-sp-chev">›</span>':'');
      return open+(link?'<a class="ft-sp-rowlink" data-sp="'+esc(id)+'" href="'+esc(link)+'" target="_blank" rel="sponsored nofollow noopener noreferrer">'+rowIn+'</a>':'<div class="ft-sp-rowlink">'+rowIn+'</div>')+'</div>';
