    // MEDIUM SLOT: picture on the left, text on the right (fixed height)
    if(pk&&szc==="m")return open+badges+'<div class="ft-sp-mbody">'+imLinked+inner+'</div></div>';
    // LARGE slot / normal card: picture on top, then text
