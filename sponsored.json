    document.documentElement.classList.add("ft-sp-lock");try{panel.querySelector("#ft-sp-sheet .ft-sp-x").focus({preventScroll:true})}catch(e){}   // FIX: stop page scrolling behind the popup + keyboard focus on Close
   
    track("sponsored_sheet_open","",{position:String(n)});
