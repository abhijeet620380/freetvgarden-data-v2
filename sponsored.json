    else if(imgUrl)im='<img class="ft-sp-img" loading="lazy" src="'+esc(imgUrl)+'" alt="'+esc(it.imageAlt||it.title||"")+'" onerror="this.style.display=\'none\'">';
    var imLinked=im&&link&&!it.__ph?'<a class="ft-sp-imglink'+(pk&&szc==="m"?' ft-sp-mlink':'')+'" data-sp="'+esc(id)+'" href="'+esc(link)+'" target="_blank" rel="sponsored nofollow noopener noreferrer">'+im+'</a>':(im&&pk&&szc==="m"?'<div class="ft-sp-mlink">'+im+'</div>':im);

    // ---------- text part ----------
    var inner="";
