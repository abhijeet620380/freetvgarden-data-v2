  // SHORTHAND: "slot": "2S" / "1-large" / "3 medium" = position 2 small / position 1 large / ... (position, size, price are filled in for you)
  function applySlot(it){
    // price comes from the rateCard for ANY entry that has a position + size (so you never write prices in slots)
    if(!(typeof it.slot==="string"&&/^\s*[1-5]\s*[-_ ]?\s*(s|m|l|small|medium|large)\s*$/i.test(it.slot))){
      var pn=parseInt(it.position,10),ps=String(it.size||"").toLowerCase().charAt(0);
      if(pn>=1&&pn<=5&&ps&&"sml".indexOf(ps)>=0)it.price=priceFor(pn,ps==="s"?"small":ps==="m"?"medium":"large")||it.price;
      return it}
    var m=typeof it.slot==="string"&&it.slot.match(/^\s*([1-5])\s*[-_ ]?\s*(s|m|l|small|medium|large)\s*$/i);
    if(!m)return it;
    var n=+m[1],sz=m[2].toLowerCase().charAt(0),name=sz==="s"?"small":sz==="m"?"medium":"large";
    if(!it.position)it.position=n;
    if(!it.size)it.size=name;
    it.price=priceFor(n,name)||it.price;
    it.slot="Position "+n+" · "+name.charAt(0).toUpperCase()+name.slice(1);
    return it;
  }
  // price of a slot from the rateCard table ("₹59" + " / 24h")
  function priceFor(n,name){
    if(!rateCard||!Array.isArray(rateCard.positions))return"";
    for(var i=0;i<rateCard.positions.length;i++){var x=rateCard.positions[i]||{};
      if((parseInt(x.n,10)||i+1)===n&&x[name])return x[name]+(rateCard.priceSuffix!==undefined?rateCard.priceSuffix:" / 24h")}
    return"";
  }
  var windows=[];     // every booking window (also future ones): used by the slot board for "next available date"
  function normalise(json){
    var list=Array.isArray(json)?json:(json&&Array.isArray(json.items)?json.items:[]);
    list=list.map(function(it,i){it=applySlot(it||{});it.__i=i;return it});
    windows=list.filter(function(it){return it.active!==false&&parseInt(it.position,10)>=1&&parseInt(it.position,10)<=5})
      .map(function(it){return{n:parseInt(it.position,10),s:parseDate(it.start,false),e:parseDate(it.end,true),size:String(it.size||"").toLowerCase()}});
    return list.filter(active)
      .sort(function(a,b){return(+a.position||99)-(+b.position||99)||(b.pinned?1:0)-(a.pinned?1:0)||(+b.priority||0)-(+a.priority||0)||a.__i-b.__i})
      .slice(0,MAX_ITEMS);
  }

  /* ---------------- fetch (live GitHub copy first, then the deployed copy) ---------------- */
  function getJson(){
    return fetch(LIVE,{cache:"no-cache",signal:AbortSignal.timeout(8000)})
      .then(function(r){if(!r.ok)throw 0;return r.json()})
      .catch(function(){return fetch(LOCAL,{cache:"no-cache",signal:AbortSignal.timeout(8000)})
        .then(function(r){if(!r.ok)throw 0;return r.json()})});
  }
  // ---- CURRENCY: prices in sponsored.json are written in INR (e.g. "₹79"). Visitors outside India see USD automatically
  // (can switch with the ₹/$ button in the panel header). USD price = INR x factor, rounded up, never below "min".
  // Override in rateCard: "usd":{"symbol":"$","factor":0.05,"min":2}  and per position "usd":{"small":2,"medium":3,"large":4}
  var lastJson=null,curMode="INR";
  try{curMode=localStorage.getItem("ft-sp-cur")||""}catch(e){}
  if(curMode!=="INR"&&curMode!=="USD"){var tz="";try{tz=Intl.DateTimeFormat().resolvedOptions().timeZone||""}catch(e){}
    curMode=/^Asia\/(Kolkata|Calcutta)$/.test(tz)?"INR":"USD"}
  function toUsdRC(rc){   // returns a converted copy of the rate card (original is untouched)
    var c=JSON.parse(JSON.stringify(rc)),u=c.usd||{},sym=u.symbol||"$",f=parseFloat(u.factor)||0,mn=parseFloat(u.min);if(!(mn>=0))mn=0;var mx=parseFloat(u.max);if(!(mx>0))mx=1e9;
    (c.positions||[]).forEach(function(x){["small","medium","large"].forEach(function(k){
      if(x.usd&&x.usd[k]!==undefined){x[k]=sym+x.usd[k];return}
      if(!f)return;   // no factor in JSON = keep the written price; USD comes only from the explicit per-slot "usd" values
      var m=String(x[k]||"").match(/(\d[\d.,]*)/);if(!m)return;
      x[k]=sym+Math.min(mx,Math.max(mn,Math.ceil(parseFloat(m[1].replace(/,/g,""))*f)))})});
    return c}
  function applyJson(j){
    if(j&&!Array.isArray(j)&&j.enabled===false)j={items:[]};
    var rc=(j&&!Array.isArray(j)&&j.rateCard&&typeof j.rateCard==="object")?j.rateCard:null;
    rateCard=(rc&&curMode==="USD")?toUsdRC(rc):rc;
    offer=(j&&!Array.isArray(j)&&j.offer!==undefined)?j.offer:null;
    if(curMode==="USD"&&offer&&typeof offer==="object"){offer=Object.assign({},offer);if(offer.priceUSD)offer.price=offer.priceUSD;else delete offer.price}   // price auto = lowest USD price
    if(PAGE&&window.innerWidth>=900){if(offer&&typeof offer==="object"&&offer.open===undefined)offer=Object.assign({},offer,{open:true});if(rateCard)rateCard=Object.assign({},rateCard,{open:true})}
    items=normalise(j);footer=(j&&!Array.isArray(j)&&typeof j.footer==="string")?j.footer:DEFAULT_FOOTER;loadedAt=Date.now();return items}
  function load(){
    return getJson().then(function(j){lastJson=j;return applyJson(j)})
      .catch(function(){items=items||[];return items});
  }

  /* ---------------- render ---------------- */
  // contact rows: [{label:"EMAIL TO BOOK", value:"you@mail.com", link:"mailto:you@mail.com", button:"Email", copy:true}]
  function renderContacts(list){
    if(!Array.isArray(list)||!list.length)return"";
    return'<div class="ft-sp-contacts">'+list.slice(0,6).map(function(c){
      c=c||{};var l=safeUrl(c.link),v=String(c.value||"");
      return'<div class="ft-sp-contact"><div class="ft-sp-ct"><div class="ft-sp-cl">'+esc(c.label||"")+'</div><div class="ft-sp-cv">'+esc(v)+'</div></div>'+
        (c.copy&&v?'<button type="button" class="ft-sp-cb ft-sp-copy" data-copy="'+esc(v)+'">Copy</button>':"")+
        (l?'<a class="ft-sp-cb fill ft-sp-contact-link" href="'+esc(l)+'" target="_blank" rel="noopener noreferrer">'+esc(c.button||"Open")+'</a>':"")+'</div>'}).join("")+'</div>'}
  // "2d 5h" / "5h 12m" / "12m" / "less than a minute"
  function leftText(ms){
    if(ms<60000)return"Ends in under a minute";
    var m=Math.floor(ms/60000),d=Math.floor(m/1440),h=Math.floor(m%1440/60),mm=m%60;
    return"Ends in "+(d?d+"d "+h+"h":h?h+"h "+mm+"m":mm+"m");
  }
  // position 1-5 -> look. 1 = gold TOP, 2 = silver, 3 = bronze (these three get the special big cards), 4-5 = standard
  var TIERS={1:{icon:"👑",name:"#1 PREMIUM",cls:"gold",hex:"#d4a017"},2:{icon:"💎",name:"#2 PLATINUM",cls:"platinum",hex:"#b8c2d3"},3:{icon:"✨",name:"#3 PREMIUM",cls:"bronze",hex:"#c27a45"},4:{icon:"",name:"#4",cls:"blue",hex:"#64b5ff"},5:{icon:"",name:"#5",cls:"gray",hex:"#c7c7cc"}};
  var cdTimer=null;
  function tickCountdowns(){
    try{if(!panel)return;
      Array.prototype.forEach.call(panel.querySelectorAll(".ft-sp-cd"),function(c){
        var left=(+c.getAttribute("data-end"))-Date.now();
        if(left<=0){var box=c.closest(".ft-sp-item");if(box)box.parentNode.removeChild(box)}   // campaign finished: remove the card
        else c.textContent="⏳ "+leftText(left)})}catch(e){}
  }
  // ---- helpers for the slot board ----
  function fmtDT(ms){return new Date(ms).toLocaleString(undefined,{day:"numeric",month:"short",hour:"numeric",minute:"2-digit"})}
  // status of one position: booked now? on hold? when is it next free? (booked as a whole - all three sizes)
  function slotInfo(n){
    var now=Date.now(),hold={};((rateCard&&Array.isArray(rateCard.reserved))?rateCard.reserved:[]).forEach(function(k){hold[k]=1});
    var ws=windows.filter(function(w){return w.n===n}),cur=null;
    ws.forEach(function(w){if(!cur&&(w.s===null||w.s<=now)&&(w.e===null||w.e>=now))cur=w});
    var hd=!cur&&!!hold[n],free=!cur&&!hd,nextFree=null,openEnded=false;
    if(cur){if(cur.e===null)openEnded=true;else{nextFree=cur.e;for(var k=0;k<12;k++){var nx=null;
        ws.forEach(function(w){if(w!==cur&&w.s!==null&&w.s<=nextFree+120000&&(w.e===null||w.e>nextFree)&&(!nx||(w.e===null||(nx.e!==null&&w.e>nx.e))))nx=w});
        if(!nx)break;if(nx.e===null){openEnded=true;nextFree=null;break}nextFree=nx.e}}}
    var upcoming=null;if(free)ws.forEach(function(w){if(w.s!==null&&w.s>now&&(!upcoming||w.s<upcoming))upcoming=w.s});
    return{cur:cur,hd:hd,free:free,nextFree:nextFree,openEnded:openEnded,upcoming:upcoming};
  }
  function bookBtn(n,label){return'<button type="button" class="ft-sp-booknow" data-sheet="'+n+'">'+esc(label)+'</button>'}
  // contacts: email address + telegram link/@id from the rateCard
  function contactInfo(){
    var r=rateCard||{},tg=safeUrl(r.bookTelegram||""),em=String(r.bookEmail||"").replace(/^mailto:/i,"").trim(),bl=safeUrl(r.bookLink||"");
    if(!tg&&!em&&bl){if(/^mailto:/i.test(bl))em=bl.replace(/^mailto:/i,"").split("?")[0];else tg=bl}
    if(!/^[^\s@<>"]+@[^\s@<>"]+$/.test(em))em="";
    return{em:em,tg:tg,handle:r.telegramHandle||(tg?"@"+tg.replace(/[?#].*$/,"").replace(/\/+$/,"").split("/").pop():"")};
  }
  // "₹59" -> {pre:"₹",n:59}; used to work out totals
  function money(str){var m=String(str||"").match(/^([^\d]*)(\d[\d.,]*)/);return m?{pre:m[1],n:parseFloat(m[2].replace(/,/g,""))}:null}
  function fmtMoney(mo,v){v=Math.round(v*100)/100;return mo.pre+(v%1?v.toFixed(2):String(v))}
  function isoDate(ms){var d=new Date(ms);return d.getFullYear()+"-"+("0"+(d.getMonth()+1)).slice(-2)+"-"+("0"+d.getDate()).slice(-2)}
  var sh={pos:1,size:"medium",days:1,custom:false,start:"",link:"",note:""};
  function durations(){var d=rateCard&&Array.isArray(rateCard.durations)&&rateCard.durations.length?rateCard.durations:[{days:1},{days:3},{days:7},{days:30}];
    return d.slice(0,6).map(function(x){x=x||{};var n=Math.max(1,parseInt(x.days,10)||1);return{days:n,off:Math.max(0,Math.min(90,+x.off||0)),label:x.label||(n+(n===1?" day":" days"))}})}
  function minStart(n){var si=slotInfo(n);return si.nextFree?isoDate(si.nextFree):isoDate(Date.now())}
  function posRow(n){var P=rateCard&&rateCard.positions||[];for(var i=0;i<P.length;i++){if((parseInt(P[i].n,10)||i+1)===n)return P[i]}return{}}
  function bookingMsg(){
    var x=posRow(sh.pos),mo=money(x[sh.size]),du=sh.custom?{days:sh.days,off:durations().filter(function(d){return d.days<=sh.days}).reduce(function(m,d){return Math.max(m,d.off||0)},0)}:(durations().filter(function(d){return d.days===sh.days})[0]||{days:sh.days,off:0}),
        start=new Date(sh.start+"T00:00:00"),end=new Date(start.getTime()+sh.days*864e5),
        dd=function(d){return d.toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"})},
        price=mo?fmtMoney(mo,mo.n)+" / day":"",tot=mo?fmtMoney(mo,mo.n*sh.days*(1-du.off/100)):"";
    var szN=sh.size.charAt(0).toUpperCase()+sh.size.slice(1);
    var lines=["Hi FreeTV Garden, I would like to book an ad slot:","• Position: #"+sh.pos+(x.name?" ("+String(x.name).replace(/^Position\s*\d+\s*[—-]\s*/i,"")+")":""),"• Card size: "+szN,
      "• Duration: "+sh.days+(sh.days===1?" day":" days")+" ("+dd(start)+" to "+dd(end)+")"];
    if(mo)lines.push("• Price: "+price+" × "+sh.days+(du.off?" − "+du.off+"%":"")+" = "+tot);
    if(sh.link)lines.push("• My website / channel: "+sh.link);
    if(sh.note)lines.push("• Notes: "+sh.note);
    lines.push("Please confirm availability and payment details.");
    return{text:lines.join("\n"),subject:"Ad booking: Position "+sh.pos+" · "+szN+" · "+sh.days+(sh.days===1?" day":" days"),total:tot,price:price,start:dd(start),end:dd(end),off:du.off};
  }
  function updateSheetSummary(){
    var el=panel&&panel.querySelector("#ft-sh-out");if(!el)return;
    var m=bookingMsg(),c=contactInfo(),h='<div class="ft-sp-sum2"><div><b>Position #'+sh.pos+'</b> · '+esc(sh.size.charAt(0).toUpperCase()+sh.size.slice(1))+' card</div><div>'+sh.days+(sh.days===1?' day':' days')+': '+esc(m.start)+' → '+esc(m.end)+'</div>'+
      (m.total?'<div>'+esc(m.price)+' × '+sh.days+(m.off?' − '+m.off+'%':'')+'</div><div class="tot">Total: '+esc(m.total)+'</div>':'')+'</div>';
    h+='<div class="ft-sp-bkcap">Send your request – tap one:</div>';
    if(c.em)h+='<a class="ft-sp-bkrow em" data-pos="'+sh.pos+'" data-via="email" href="mailto:'+esc(c.em)+'?subject='+esc(encodeURIComponent(m.subject))+'&body='+esc(encodeURIComponent(m.text))+'"><span class="ico">✉</span><span class="bt"><b>Email</b><i>'+esc(c.em)+'</i></span><span class="go">Send ›</span></a>';
    if(c.tg)h+='<a class="ft-sp-bkrow tg" data-pos="'+sh.pos+'" data-via="telegram" href="'+esc(c.tg+(c.tg.indexOf("?")<0?"?":"&")+"text="+encodeURIComponent(m.text))+'" target="_blank" rel="noopener noreferrer"><span class="ico">✈</span><span class="bt"><b>Telegram</b><i>'+esc(c.handle)+'</i></span><span class="go">Send ›</span></a>';
    h+='<button type="button" class="ft-sp-copy2" data-copymsg="1">📋 Copy the message (to send anywhere)</button><div class="ft-sp-small-note">No payment now. We confirm availability and the final price first, then you pay.'+(rateCard&&rateCard.sheetNote?" "+esc(rateCard.sheetNote):"")+'</div>';
    el.innerHTML=h;
  }
  function renderSheet(){
    var el=panel&&panel.querySelector("#ft-sp-sheet");if(!el)return;
    var P=(rateCard&&rateCard.positions||[]).slice(0,5),h='<div class="ft-sp-sh-head"><b>📝 Book an ad slot</b><button class="ft-sp-x" type="button" data-shclose="1" aria-label="Close">✕</button></div><div class="ft-sp-sh-body">';
    h+='<div class="ft-sp-sh-l">1 · Choose a position</div><div class="ft-sp-chs">'+P.map(function(x,i){var n=parseInt(x.n,10)||i+1,si=slotInfo(n),dis=si.hd||(si.openEnded),t=TIERS[n]||TIERS[5];
      return'<button type="button" class="ft-sp-ch'+(sh.pos===n?' sel':'')+(dis?' dis':'')+'" data-sh="pos" data-v="'+n+'"'+(dis?' disabled':'')+'><b>'+(t.icon||"")+' #'+n+'</b><i>'+(si.free?'Vacant':si.hd?'On hold':si.openEnded?'Booked':'From '+esc(new Date(si.nextFree).toLocaleDateString(undefined,{day:"numeric",month:"short"})))+'</i></button>'}).join("")+'</div>';
    var x=posRow(sh.pos);
    h+='<div class="ft-sp-sh-l">2 · Choose a card size</div><div class="ft-sp-chs">'+[["small","Small","list row"],["medium","Medium","picture + text"],["large","Large","biggest"]].map(function(c){
      return'<button type="button" class="ft-sp-ch'+(sh.size===c[0]?' sel':'')+'" data-sh="size" data-v="'+c[0]+'"><b>'+c[1]+'</b><i>'+esc((x[c[0]]||"—")+" / day · "+c[2])+'</i></button>'}).join("")+'</div>';
    h+='<div class="ft-sp-sh-l">3 · How long?</div><div class="ft-sp-chs">'+durations().map(function(d){
      return'<button type="button" class="ft-sp-ch'+(!sh.custom&&sh.days===d.days?' sel':'')+'" data-sh="days" data-v="'+d.days+'"><b>'+esc(d.label)+'</b>'+(d.off?'<i>'+d.off+'% off</i>':'')+'</button>'}).join("")+
      '<button type="button" class="ft-sp-ch'+(sh.custom?' sel':'')+'" data-sh="custom" data-v="1"><b>✏️ Custom</b><i>any days</i></button></div>'+
      (sh.custom?'<div style="font-size:.72rem;color:#9fc4f5;margin:8px 0 4px">Number of days (1 – 365):</div><input class="ft-sp-in" type="number" id="ft-sh-days" min="1" max="365" step="1" inputmode="numeric" value="'+sh.days+'">':'');
    var mn=minStart(sh.pos);if(!sh.start||sh.start<mn)sh.start=mn;
    h+='<div class="ft-sp-sh-l">4 · Start date</div><input class="ft-sp-in" type="date" id="ft-sh-start" min="'+mn+'" value="'+esc(sh.start)+'">'+(slotInfo(sh.pos).free?'':'<div class="ft-sp-small-note" style="margin:0 0 6px">This position is booked until '+esc(fmtDT(slotInfo(sh.pos).nextFree))+' – earliest start shown.</div>');
    h+='<div class="ft-sp-sh-l">5 · Your website / channel (optional)</div><input class="ft-sp-in" type="text" id="ft-sh-link" maxlength="200" placeholder="https://…  or  @yourchannel" value="'+esc(sh.link)+'"><textarea class="ft-sp-in" id="ft-sh-note" maxlength="300" placeholder="Anything we should know? (optional)">'+esc(sh.note)+'</textarea>';
    h+='<div id="ft-sh-out"></div></div>';
