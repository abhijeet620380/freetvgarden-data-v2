  }
  // VACANT SLOTS: your own ad ("rateCard.vacant.html", tag "Ad") and "Advertise here" messages (tag "Advertise").
  // They are ALWAYS shown AFTER all paid slots - never above a paid slot or between two paid slots.
  function vacantMsg(n){
    var v=(rateCard&&rateCard.vacant)||{},sz=String(v.size||"small").toLowerCase();
    return renderItem({__i:-1,__vac:true,id:"vacant-"+n,position:n,size:sz,label:v.messageLabel||"Advertise",
      title:v.title||"Advertise here",text:v.text||"This slot is free. Promote your website, app or channel here.",
      link:"#board",button:v.button||"Book this slot",price:priceFor(n,sz==="large"||sz==="l"?"large":sz==="medium"||sz==="m"?"medium":"small")});
  }
  // minimum price in the rateCard table (e.g. "₹9"), used by the default offer text
  function minPrice(){var best=null,P=(rateCard&&rateCard.positions)||[];
    P.forEach(function(x){["small","medium","large"].forEach(function(k){var m=money(x&&x[k]);if(m&&(best===null||m.n<best.n))best=m})});
    return best?fmtMoney(best,best.n):""}
  // HERO = offer + slot status in one block. top-level "offer": {"price":"₹9","priceNote":"for 24 hr","text":"...","more":"...","button":"Show more","open":false,"enabled":false}
  // price defaults to the lowest price in the table.
  function offerHtml(){
    var o=offer;if(o===false)return"";
    if(!o||typeof o!=="object")o={};
    if(o.enabled===false)return"";
    var price=o.price||(slotMode()?minPrice():""),note=o.priceNote||"for 24 hr",text=o.text||(slotMode()?"Anyone can book a slot":"");
    if(!price&&!text)return"";
    var tx=text?md(text).replace(/^<p[^>]*>|<\/p>$/g,"").replace(/<\/p><p[^>]*>/g,"<br>"):"";
    var dots="";
    if(slotMode()){var n5=Math.min(5,rateCard.positions.length),fr=0;dots='<div class="ft-sp-dots">';
      for(var q=1;q<=n5;q++){var qi=slotInfo(q);if(qi.free)fr++;dots+='<button type="button" class="ft-sp-dot2 '+(qi.free?'free':'busy')+'" data-strip="'+q+'" title="Slot #'+q+(qi.free?' vacant':' booked')+'">'+q+'</button>'}
      dots+='<em>'+fr+' free</em></div>'}
    var more=o.more?'<div class="ft-sp-offer-more">'+md(o.more)+(slotMode()?'<div class="ft-sp-offer-cta"><button type="button" class="a" data-sheet="0">📝 Book a slot</button><button type="button" class="b" data-offerboard="1">View prices</button></div>':'')+'</div>':'';
    return'<div class="ft-sp-hero'+(o.open===true?' open':'')+'" id="ft-sp-offer"><div class="ft-sp-hero-top">'+
      (price?'<div class="ft-sp-bigp"><span>'+esc(price)+'</span><small>'+esc(note)+'</small></div>':'')+
      '<div class="ft-sp-hero-mid">'+(tx?'<div class="ft-sp-hero-t">'+tx+'</div>':'')+dots+'</div>'+
      (more?'<button type="button" class="ft-sp-offer-b" data-offer="1" data-show="'+esc(o.button||"Show more")+'" data-hide="Show less">'+esc(o.open===true?"Show less":(o.button||"Show more"))+'</button>':'')+'</div>'+more+'</div>';
  }
  function slotMode(){return !!(rateCard&&Array.isArray(rateCard.positions)&&rateCard.positions.length)}
  // order in the panel (slot mode): 1) booked slots by position  2) your ad (always)  3) "Advertise here" cards for the vacant positions
  function cardsHtml(){
    if(!slotMode())return offerHtml()+items.map(renderItem).join("");
    var v=rateCard.vacant||{},paid="",vac=[],adH="",msgH="";
    for(var n=1;n<=Math.min(5,rateCard.positions.length);n++){
      var it=null;for(var i=0;i<items.length;i++){if(parseInt(items[i].position,10)===n){it=items[i];break}}
      if(it)paid+=renderItem(it);else vac.push(n)}
    if(v.html)for(var k=0;k<(parseInt(v.maxAds,10)||1);k++)
      adH+=renderItem({__i:-1,id:"vacant-ad-"+k,label:v.label||"Ad",html:v.html,height:v.height,sameOrigin:v.sameOrigin===true,background:v.background});
    msgH=vac.map(vacantMsg).join("");
    var extra="";items.forEach(function(x){if(!(parseInt(x.position,10)>=1)&&x.extra===true)extra+=renderItem(x)});   // "extra":true = also show a non-slot entry
