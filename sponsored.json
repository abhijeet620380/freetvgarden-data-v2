        '<style>html,body{margin:0;padding:0;background:transparent;text-align:center}body{display:flex;justify-content:center;align-items:flex-start}img,iframe{max-width:100%}</style></head><body>'+it.html+'</body></html>';
      var bg=/^(#[0-9a-f]{3,8}|rgba?\([\d\s.,%]+\)|[a-z]+)$/i.test(String(it.background||""))?it.background:"transparent";   // optional per-ad background colour
      return open+badges+'<iframe class="ft-sp-frame" style="height:'+hgt+'px;background:'+bg+'" sandbox="'+sb+'" loading="lazy" srcdoc="'+esc(doc)+'"></iframe></div>';
