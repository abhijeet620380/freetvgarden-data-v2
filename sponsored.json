    if(it.price)chips+='<span class="ft-sp-chip ft-sp-price">'+esc(priceTxt)+'</span>';
    if(pk)chips+='<span class="ft-sp-chip">📐 '+sizeName+'</span>';
    if(cdLive)chips+='<span class="ft-sp-chip ft-sp-cd" data-end="'+endMs+'">⏳ '+esc(leftText(endMs-Date.now()))+'</span>';
    else if(endTxt)chips+='<span class="ft-sp-chip'+(it.__vac?' ft-sp-ok':'')+'">'+esc(endTxt)+'</span>';
    var badges='<div class="ft-sp-badges"><span class="ft-sp-tag'+lcls+'"'+lsty+'>'+tag+'</span>'+
      (tier&&!it.__vac?'<span class="ft-sp-tag tier ft-sp-c-'+tier.cls+'">'+tier.icon+' '+tier.name+'</span>':'')+(it.pinned&&!tier?'<span class="ft-sp-tag ft-sp-c-gold">📌 Pinned</span>':'')+chips+'</div>';
    var cls='ft-sp-item'+(it.pinned?' ft-sp-pinned':'')+(pk?' ft-sp-pk ft-sp-sz-'+szc:'')+(pos&&!it.__vac?' ft-sp-p'+pos:'')+(it.__sample?' ft-sp-sample':'')+(it.__vac?' ft-sp-vac':'')+(it.html?' ft-sp-ad':'');
    var open='<div class="'+cls+'" data-id="'+esc(id)+'"'+(pos&&!it.__vac&&!it.__sample?' data-slot="'+pos+'"':'')+(ac?' style="border-color:'+ac+'"':'')+'>';
    // heading colour: white by default. "titleColor" = any colour (preset name or hex), independent of the card border colour.
    var tc=String(it.titleColor||"").toLowerCase(),tcv=acHex[tc]||(/^#[0-9a-f]{3,8}$/i.test(tc)?tc:"");
    var hStyle=tcv?' style="color:'+tcv+'"':'';
