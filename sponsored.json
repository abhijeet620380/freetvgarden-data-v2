  }
  function render(){
    var body=panel.querySelector(".ft-sp-body");
    body.innerHTML=((items&&items.length)||slotMode())?cardsHtml()+renderRates(rateCard,items)+(footer?'<div class="ft-sp-foot">'+esc(footer)+(contactInfo().em?' <a href="mailto:'+esc(contactInfo().em)+'?subject='+esc(encodeURIComponent("Report an ad on FreeTV Garden"))+'">Report an ad</a>':'')+'</div>':""):'<div class="ft-sp-empty">No sponsored content right now.</div>';
    if(!PAGE)body.scrollTop=0;
