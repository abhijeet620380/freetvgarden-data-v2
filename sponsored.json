  function renderSheet(){
    var el=panel&&panel.querySelector("#ft-sp-sheet");if(!el)return;
    fixSize();clampDays();
    var fi=freeInfo(),P=(rateCard&&rateCard.positions||[]).slice(0,5),h='<div class="ft-sp-sh-head"><b>📝 Book an ad slot</b><button class="ft-sp-x" type="button" data-shclose="1" aria-label="Close">✕</button></div><div class="ft-sp-sh-body">';
    if(fi)h+='<div class="ft-sp-freebar">🎁 <b>FREE launch offer</b>'+(fi.until?' until '+esc(fmtD(fi.until)):'')+' – no payment'+(fi.maxDays?', up to '+fi.maxDays+' days per booking':'')+'.</div>';
