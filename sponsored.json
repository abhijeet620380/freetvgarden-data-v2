          track("sponsored_copy",id)}
        return}
      var a=e.target.closest&&e.target.closest("a[href]"),box=a&&a.closest(".ft-sp-item");
      if(!box)return;
      var kind=a.classList.contains("ft-sp-rowlink")?"row":a.classList.contains("ft-sp-contact-link")?"contact":a.classList.contains("ft-sp-btn")?"button":(a.classList.contains("ft-sp-imglink")?"image":"text_link");
      track("sponsored_click",box.getAttribute("data-id"),{click_type:kind,link_domain:domainOf(a.getAttribute("href"))});
    });
  }
  function open(){
    if(!panel)build();
    // make sure the Recent/Favourites list and the notices/language panels are not open underneath
    try{var rf=document.getElementById("ft-rf-overlay");if(rf&&rf.classList.contains("open"))document.getElementById("ft-rf-close").click()}catch(e){}
    try{var n=document.getElementById("ft-notif-panel");if(n&&n.classList.contains("open"))document.getElementById("ft-notif-close").click()}catch(e){}
    try{var l=document.getElementById("ft-lang-panel");if(l&&l.classList.contains("open"))document.getElementById("ft-lang-close").click()}catch(e){}
    ["ft-rf-tab-recent","ft-rf-tab-fav"].forEach(function(id){var b=document.getElementById(id);if(b)b.classList.remove("active")});
    render();panel.classList.add("open");if(btn)btn.classList.add("active");if(barBtn)barBtn.classList.add("active");
    lsSet(SEEN_KEY,signature());updateDot();
    track("sponsored_open","",{item_count:(items||[]).length});          // GA4: how many times the panel was opened
    clearInterval(cdTimer);cdTimer=setInterval(function(){tickCountdowns();expireCheck()},20000);   // refresh countdown chips every 20s while open
    watchViews();                                                          // GA4: sponsored_view per entry, when scrolled into sight
    // quietly refresh if the data is old (a new ad you just committed shows without a page reload)
    if(Date.now()-loadedAt>STALE_MS)load().then(function(){if(panel.classList.contains("open"))render()});
  }
  /* sponsored_view = an entry was actually visible (>=50%) in the panel. Counted once per entry per opening. */
  var viewObs=null;
  function watchViews(){
    try{
      if(viewObs)viewObs.disconnect();
      var els=panel.querySelectorAll(".ft-sp-item");
      if(!("IntersectionObserver" in window)){Array.prototype.forEach.call(els,function(el){track("sponsored_view",el.getAttribute("data-id"))});return}
      viewObs=new IntersectionObserver(function(es){es.forEach(function(en){
        if(en.isIntersecting){track("sponsored_view",en.target.getAttribute("data-id"));viewObs.unobserve(en.target)}})},{root:PAGE?null:panel.querySelector(".ft-sp-body"),threshold:.5});
      Array.prototype.forEach.call(els,function(el){viewObs.observe(el)});
    }catch(e){}
  }
  /* CLICKS INSIDE AN HTML AD: the browser hides what happens inside an ad iframe, but when someone taps/clicks it,
     the page loses focus and the iframe becomes the "active element". We count that as a click on that ad. */
  window.addEventListener("blur",function(){setTimeout(function(){
    try{var a=document.activeElement;
      if(a&&a.classList&&a.classList.contains("ft-sp-frame")){
        var box=a.closest(".ft-sp-item");if(box)track("sponsored_click",box.getAttribute("data-id"),{click_type:"html_ad"});
        setTimeout(function(){try{window.focus()}catch(e){}},0)}   // take focus back so the NEXT click is counted too
    }catch(e){}},0)});
  function close(){if(PAGE){closeSheet();return}clearInterval(cdTimer);closeSheet();if(viewObs){viewObs.disconnect()}if(panel){panel.classList.remove("open");
    // empty the panel so ad iframes stop running while it is hidden
    var b=panel.querySelector(".ft-sp-body");if(b)b.innerHTML=""}
    if(btn)btn.classList.remove("active");if(barBtn)barBtn.classList.remove("active")}
  function expireCheck(){try{
    if(!lastJson||!panel||!panel.classList.contains("open"))return;
    var n=Date.now();
    if((items||[]).some(function(it){var e=parseDate(it.end,true);return e!==null&&e<n})){applyJson(lastJson);render();watchViews()}   // something expired: rebuild without it
  }catch(e){}}
  document.addEventListener("visibilitychange",function(){if(!document.hidden)expireCheck()});
  function isOpen(){return !!(panel&&panel.classList.contains("open"))}

  /* ---------------- create the pill (only when there is something to show) ---------------- */
  function addButton(){
    if(btn||!items||!(items.length||slotMode()))return;
    var recent=document.getElementById("ft-rf-tab-recent");
    if(!recent||!recent.parentNode)return;
    btn=document.createElement("button");
    btn.className="ft-rf-tab";btn.id="ft-sp-tab";btn.type="button";
    btn.innerHTML='📢 Sponsored<span class="ft-sp-dot"></span>';
    recent.parentNode.insertBefore(btn,recent);          // <- placed BEFORE Recent
    btn.addEventListener("click",function(){isOpen()?close():open()});
    updateDot();
  }
  /* icon-only button in the player bar: placed right after the favourite star (found by id/class/text/label containing
     epg / guide / schedule). If no EPG button is found it goes just before the report-flag icon, or at the end. */
  function placeBarBtn(){
    try{
      var bar=document.querySelector(".now-playing-bar");
      if(!bar||!items||!(items.length||slotMode()))return;
      if(!barBtn){
        barBtn=document.createElement("button");barBtn.id="ft-sp-bar";barBtn.type="button";
        barBtn.title="Sponsored";barBtn.setAttribute("aria-label","Sponsored");
        // megaphone + $ coin icon, no text (own drawing)
        barBtn.innerHTML='<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.5" cy="12" r="6"/><path d="M7.5 8.2v7.6M9.6 9.7c-.4-.8-1.1-1.1-2.1-1.1-1.2 0-2 .6-2 1.5s.8 1.3 2 1.5 2 .6 2 1.6-.8 1.5-2 1.5c-1 0-1.8-.4-2.2-1.2"/><path d="M14.2 9l5.8-3.4v12.8L14.2 15"/><path d="M22.3 10v4"/></svg><span class="ft-sp-dot"></span>';
        barBtn.addEventListener("click",function(e){e.stopPropagation();isOpen()?close():open()});   // stopPropagation: the bar is draggable
        updateDot();
      }
      /* put the icon right AFTER the favourite star (#np-fav-star). If the star is not there yet, fall back to
         "after the EPG button", then "before the report flag", then the end of the bar. */
      var anchor=document.getElementById("np-fav-star");
      if(!anchor||!bar.contains(anchor)){
        [].some.call(bar.querySelectorAll("button,a,div,span"),function(n){
          if(n===barBtn||barBtn.contains(n))return false;
          var t=((n.id||"")+" "+(n.getAttribute("aria-label")||"")+" "+(n.title||"")+" "+((n.children.length?"":n.textContent)||"")).toLowerCase();
          if(/epg|guide|schedule/.test(t)){anchor=n;return true}return false})}
      while(anchor&&anchor.parentNode!==bar)anchor=anchor.parentNode;   // climb to the bar's direct child
      if(anchor){if(anchor.nextSibling!==barBtn)bar.insertBefore(barBtn,anchor.nextSibling)}
      else{var rp=document.getElementById("ft-report-btn");
        if(rp&&rp.parentNode===bar){if(barBtn.nextSibling!==rp)bar.insertBefore(barBtn,rp)}
        else if(barBtn.parentNode!==bar)bar.appendChild(barBtn)}
    }catch(e){}
  }
  function watchBar(){
    placeBarBtn();
    try{var bar=document.querySelector(".now-playing-bar");
      if(bar&&window.MutationObserver){var busy=false;new MutationObserver(function(){   // the EPG button can appear later / be rebuilt: keep us next to it
        if(busy)return;busy=true;setTimeout(function(){busy=false;placeBarBtn()},150)}).observe(bar,{childList:true})}}catch(e){}
  }

  // opening Recent / Favourites closes the sponsored panel
  document.addEventListener("click",function(e){
    var t=e.target&&e.target.closest&&e.target.closest("#ft-rf-tab-recent,#ft-rf-tab-fav");
    if(t&&isOpen())close();
  },true);
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&isOpen()){if(sheetOpen())closeSheet();else close()}});
  // FIX: click / tap OUTSIDE the booking popup closes it (buttons that open the popup are ignored)
  document.addEventListener("click",function(e){
    if(!sheetOpen())return;var t=e.target;if(!t||!t.closest)return;
    if(t.closest("#ft-sp-sheet")||t.closest("[data-sheet],[data-strip],a[href='#board']"))return;
    closeSheet();
  },true);
  // on a phone the notices bell / language picker open full-screen panels: close ours first
  document.addEventListener("click",function(e){
    if(isOpen()&&e.target.closest&&e.target.closest("#notif-btn,#btn-select-lang"))close();
  },true);

  /* ---------------- start AFTER the page has loaded and the browser is idle (no effect on load speed) ---------------- */
  function start(){load().then(function(){if(PAGE){open();return}addButton();watchBar()})}
  function whenIdle(){("requestIdleCallback"in window)?requestIdleCallback(start,{timeout:4000}):setTimeout(start,3000)}
  if(PAGE)start();   // standalone page: start right away
  else if(document.readyState==="complete")setTimeout(whenIdle,2500);
  else window.addEventListener("load",function(){setTimeout(whenIdle,2500)});
}catch(err){}})();
</script>
</body>
</html>
