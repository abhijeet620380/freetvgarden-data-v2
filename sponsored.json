  function openSheet(n){
    var P=(rateCard&&rateCard.positions)||[];if(!P.length)return;
    if(!n){for(var i=1;i<=5;i++){var si=slotInfo(i);if(si.free){n=i;break}}if(!n){for(i=1;i<=5;i++){if(slotInfo(i).nextFree){n=i;break}}}n=n||1}
    sh.pos=n;sh.start="";var sz=["small","medium","large"];if(sz.indexOf(sh.size)<0)sh.size="medium";
