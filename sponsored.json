  }

  /* ---------------- unread dot ---------------- */
  function signature(){return(items||[]).map(function(i){return i.id||i.__i}).join("|")+(slotMode()?"|slots":"")}
  function updateDot(){var n=!!((items&&items.length)||slotMode())&&lsGet(SEEN_KEY)!==signature();
    if(btn)btn.classList.toggle("ft-sp-new",n);if(barBtn)barBtn.classList.toggle("ft-sp-new",n)}

  /* ---------------- open / close ---------------- */
  function build(){
    panel=document.createElement("div");panel.id="ft-sp-panel";
    panel.setAttribute("role","dialog");panel.setAttribute("aria-label","Sponsored");
    panel.innerHTML='<div class="ft-sp-head"><div class="ft-sp-title">📢 Sponsored</div><button type="button" class="ft-sp-cur" id="ft-sp-cur" title="Change currency"></button><button type="button" class="ft-sp-adv" id="ft-sp-adv">📣 Advertise</button><button class="ft-sp-x" id="ft-sp-close" aria-label="Close">✕</button></div><div class="ft-sp-body"></div><div class="ft-sp-sheet" id="ft-sp-sheet" role="dialog" aria-modal="true" aria-label="Book an ad slot"></div>';
    (PAGE?document.getElementById("sp-root"):document.body).appendChild(panel);
    panel.querySelector("#ft-sp-close").onclick=close;
    var curB=panel.querySelector("#ft-sp-cur");
    function curLabel(){curB.textContent=curMode==="USD"?"$ USD":"₹ INR"}
    curLabel();
    curB.onclick=function(){curMode=curMode==="USD"?"INR":"USD";try{localStorage.setItem("ft-sp-cur",curMode)}catch(e){}
      curLabel();if(lastJson)applyJson(lastJson);render();if(sheetOpen())renderSheet();track("sponsored_currency",curMode)};   // FIX: popup prices refresh too
    // count clicks on links, buttons and banners (GA4 event sponsored_click)
    panel.addEventListener("input",function(e){var t=e.target;
      if(t.id==="ft-sh-start"){var mn=minStart(sh.pos);sh.start=(t.value&&t.value>=mn)?t.value:mn}
      else if(t.id==="ft-sh-days"){var dv=parseInt(t.value,10);sh.days=dv>=1?Math.min(365,dv):1}else if(t.id==="ft-sh-link")sh.link=t.value.trim();else if(t.id==="ft-sh-note")sh.note=t.value.trim();else return;
      updateSheetSummary()});
    panel.addEventListener("click",function(e){
      var ofB=e.target.closest&&e.target.closest("[data-offer]");
      if(ofB){var ob=ofB.closest(".ft-sp-hero"),oo=ob.classList.toggle("open");ofB.textContent=oo?ofB.getAttribute("data-hide"):ofB.getAttribute("data-show");if(oo)track("sponsored_offer_expand","");return}
      var ofV=e.target.closest&&e.target.closest("[data-offerboard]");
      if(ofV){var rc3=panel.querySelector("#ft-sp-rates");if(rc3){rc3.classList.add("open");var rt3=rc3.querySelector("[data-rates]");if(rt3)rt3.textContent=rt3.getAttribute("data-hide");rc3.scrollIntoView({behavior:"smooth",block:"start"})}return}
      var shX=e.target.closest&&e.target.closest("[data-shclose]");
      if(shX){closeSheet();return}
      var chB=e.target.closest&&e.target.closest("[data-sh]");
      if(chB&&!chB.disabled){var k=chB.getAttribute("data-sh"),v=chB.getAttribute("data-v");
        if(k==="pos"){sh.pos=parseInt(v,10);sh.start=""}else if(k==="size")sh.size=v;else if(k==="days"){sh.days=parseInt(v,10);sh.custom=false}else if(k==="custom"){sh.custom=true;if(!(sh.days>=1))sh.days=1}
        renderSheet();return}
      var cpm=e.target.closest&&e.target.closest("[data-copymsg]");
      if(cpm){var tx=bookingMsg().text,dn=function(){var t0=cpm.textContent;cpm.textContent="Copied ✓";setTimeout(function(){cpm.textContent=t0},1500)};
        try{navigator.clipboard.writeText(tx).then(dn,dn)}catch(x){try{var ta=document.createElement("textarea");ta.value=tx;ta.style.cssText="position:fixed;opacity:0";document.body.appendChild(ta);ta.select();document.execCommand("copy");document.body.removeChild(ta);dn()}catch(y){}}
        track("sponsored_copy_request","",{position:String(sh.pos)});return}
      var shB=e.target.closest&&e.target.closest("[data-sheet]");
      if(shB){openSheet(parseInt(shB.getAttribute("data-sheet"),10)||0);return}
      var stB=e.target.closest&&e.target.closest("[data-strip]");
      if(stB){var sn=parseInt(stB.getAttribute("data-strip"),10);
        if(slotInfo(sn).free){openSheet(sn)}else{var cardEl=panel.querySelector('[data-slot="'+sn+'"]');if(cardEl)cardEl.scrollIntoView({behavior:"smooth",block:"center"});else openSheet(sn)}
