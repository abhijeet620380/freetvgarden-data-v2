<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Advertise on FreeTV Garden – Sponsored Slots from $1 / ₹9 per 24 hours</title>
<meta name="description" content="Promote your website, app, YouTube channel or social page to FreeTV Garden visitors. 5 sponsored positions in Small, Medium or Large size. Prices start at just ₹9 / $1 for 24 hours.">
<!-- SEO: this page is separate from the TV player pages and has its own title/description/canonical.
     To keep it OUT of Google completely, change "index,follow" to "noindex,follow". -->
<meta name="robots" content="index,follow,max-image-preview:large">
<link rel="canonical" href="https://freetvgarden.com/sponsored.html">
<meta name="theme-color" content="#1c1c1e">
<meta name="color-scheme" content="dark">
<meta property="og:type" content="website">
<meta property="og:title" content="Advertise on FreeTV Garden – Sponsored Slots">
<meta property="og:description" content="Promote your website, app or channel to FreeTV Garden visitors. From ₹9 / $1 for 24 hours.">
<meta property="og:url" content="https://freetvgarden.com/sponsored.html">
<link rel="icon" href="/favicon.ico">
<style id="ft-sp-css">
/* NOTE: "#ft-tv-app " prefix is needed: the site has "#ft-tv-app button{all:unset}" which would otherwise wipe these rules */
/* the pill itself reuses the existing .ft-rf-tab look; we only add the unread dot */
#ft-tv-app #ft-sp-tab{position:relative;white-space:nowrap}
#ft-tv-app #ft-sp-tab .ft-sp-dot{position:absolute;top:-2px;right:-2px;width:9px;height:9px;border-radius:50%;background:#ff453a;border:2px solid #1c1c1e;display:none}
#ft-tv-app #ft-sp-tab.ft-sp-new .ft-sp-dot{display:block}
/* icon-only Sponsored button in the player's "now playing" bar: megaphone + $ coin, sits right after the favourite star */
#ft-tv-app #ft-sp-bar{position:relative;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;width:32px;height:32px;padding:0;margin:0 2px;border-radius:8px;cursor:pointer;color:#32d74b;background:none;border:0;line-height:0;-webkit-tap-highlight-color:transparent;transition:transform .15s,background .15s}
#ft-tv-app #ft-sp-bar svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
#ft-tv-app #ft-sp-bar:hover{background:rgba(50,215,75,.16)}
#ft-tv-app #ft-sp-bar:active{transform:scale(.9)}
#ft-tv-app #ft-sp-bar.active{background:rgba(50,215,75,.25)}
#ft-tv-app #ft-sp-bar .ft-sp-dot{position:absolute;top:1px;right:1px;width:9px;height:9px;border-radius:50%;background:#ff453a;border:2px solid #3a3a3c;display:none}
#ft-tv-app #ft-sp-bar.ft-sp-new .ft-sp-dot{display:block}

/* the panel: phone = full screen */
#ft-sp-panel{position:fixed;inset:0;z-index:4300;background:#1c1c1e;color:#f2f2f7;display:none;flex-direction:column;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}
#ft-sp-panel.open{display:flex}
#ft-sp-panel .ft-sp-head{display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid #3a3a3c;flex-shrink:0}
#ft-sp-panel .ft-sp-title{flex:1;font-size:1.05rem;font-weight:700}
#ft-sp-panel .ft-sp-x{width:34px;height:34px;border-radius:50%;border:0;background:#3a3a3c;color:#fff;font-size:1rem;cursor:pointer;line-height:34px;text-align:center;padding:0}
#ft-sp-panel .ft-sp-x:hover{background:#4a4a4d}
#ft-sp-panel .ft-sp-body{flex:1;overflow-y:auto;padding:14px;-webkit-overflow-scrolling:touch}
#ft-sp-panel .ft-sp-empty{color:#8e8e93;text-align:center;padding:40px 10px}

/* PC: right-hand side panel under the header, same place/size as the Notices panel */
@media (min-width:769px){
  #ft-sp-panel{inset:auto;top:var(--global-header-height,56px);right:0;bottom:0;left:auto;width:min(480px,40vw);border-left:1px solid #3a3a3c;box-shadow:-8px 0 24px rgba(0,0,0,.45)}
}

/* one entry */
#ft-sp-panel .ft-sp-item{background:#2c2c2e;border:1px solid #3a3a3c;border-radius:14px;margin:0 0 14px;overflow:hidden}
/* the row of badges at the top of every entry: label badge (Ad / Sponsored / Partner ...), optional Pinned badge, small info chips */
#ft-sp-panel .ft-sp-badges{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:10px 14px 0}
#ft-sp-panel .ft-sp-tag{display:inline-block;font-size:.62rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;padding:3px 8px;border-radius:6px;color:#d1d1d6;background:rgba(142,142,147,.22);border:1px solid rgba(142,142,147,.45)}
#ft-sp-panel .ft-sp-chip{display:inline-block;font-size:.66rem;font-weight:600;padding:2px 8px;border-radius:10px;color:#aeaeb2;background:#1c1c1e;border:1px solid #3a3a3c}
/* ready-made label colours (use "labelColor": "green" ... or any hex like "#ff6600") */
#ft-sp-panel .ft-sp-c-green{color:#32d74b;background:rgba(50,215,75,.15);border-color:rgba(50,215,75,.5)}
#ft-sp-panel .ft-sp-c-gold{color:#ffd60a;background:rgba(255,214,10,.15);border-color:rgba(255,214,10,.5)}
#ft-sp-panel .ft-sp-c-red{color:#ff6961;background:rgba(255,69,58,.16);border-color:rgba(255,69,58,.5)}
#ft-sp-panel .ft-sp-c-blue{color:#64b5ff;background:rgba(10,132,255,.16);border-color:rgba(10,132,255,.5)}
#ft-sp-panel .ft-sp-c-purple{color:#d9a6ff;background:rgba(191,90,242,.16);border-color:rgba(191,90,242,.5)}
#ft-sp-panel .ft-sp-c-orange{color:#ffb340;background:rgba(255,159,10,.16);border-color:rgba(255,159,10,.5)}
#ft-sp-panel .ft-sp-c-gray{color:#d1d1d6;background:rgba(142,142,147,.22);border-color:rgba(142,142,147,.45)}
/* pinned / large entries: bigger heading and text, accent border */
#ft-sp-panel .ft-sp-item.ft-sp-pinned{border-color:#ffd60a;box-shadow:0 0 0 1px rgba(255,214,10,.25)}
#ft-sp-panel .ft-sp-cd{color:#ffb340;border-color:rgba(255,159,10,.5);background:rgba(255,159,10,.12);font-weight:700}
/* price tag on an entry, and the "slot prices" rate-card */
#ft-sp-panel .ft-sp-price{color:#0b0b0c;background:#ffd60a;border:0;font-weight:800;border-radius:6px;padding:3px 9px}
#ft-sp-panel .ft-sp-rates{background:#2c2c2e;border:1px dashed #5a5a5e;border-radius:14px;margin:0 0 14px;overflow:hidden}
#ft-sp-panel .ft-sp-rates .ft-sp-inner{padding-top:12px}
#ft-sp-panel .ft-sp-rate{display:flex;align-items:center;gap:10px;padding:9px 0;border-top:1px solid #3a3a3c}
#ft-sp-panel .ft-sp-rate:first-of-type{border-top:0}
#ft-sp-panel .ft-sp-rn{flex:1;min-width:0}
#ft-sp-panel .ft-sp-rn b{display:block;font-size:.9rem;color:#fff}
#ft-sp-panel .ft-sp-rn span{display:block;font-size:.72rem;color:#8e8e93;margin-top:2px}
#ft-sp-panel .ft-sp-rp{flex-shrink:0;font-weight:800;font-size:.9rem;color:#ffd60a;text-align:right}
#ft-sp-panel .ft-sp-rates-body{display:none}
#ft-sp-panel .ft-sp-rates.open .ft-sp-rates-body{display:block}
/* ===== FIXED SLOT SIZES (only for entries with a "position"). A slot can NEVER grow past its size: extra text is cut with "..." =====
   SMALL  = compact list row, exactly 88px high: 64px thumbnail, 1-line title, 2-line text, no big image
   MEDIUM = card exactly 196px high: 112px-wide image on the left, title (2 lines), text (3 lines), small button
   LARGE  = biggest card, never taller than 440px: 160px image on top, title (2 lines), text (4 lines), button */
#ft-sp-panel .ft-sp-pk{overflow:hidden;box-sizing:border-box}
#ft-sp-panel .ft-sp-sz-s{height:96px;margin-bottom:10px;position:relative}
#ft-sp-panel .ft-sp-sz-m{height:196px;display:flex;flex-direction:column}
#ft-sp-panel .ft-sp-sz-l{max-height:440px}
#ft-sp-panel .ft-sp-tx{line-height:1.4}
#ft-sp-panel .ft-sp-pk .ft-sp-tx,#ft-sp-panel .ft-sp-pk .ft-sp-h{display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden}
#ft-sp-panel .ft-sp-pk .ft-sp-h{-webkit-line-clamp:2}
/* small = list row */
#ft-sp-panel .ft-sp-rowlink{display:flex;align-items:center;gap:10px;height:100%;box-sizing:border-box;padding:8px 10px;color:inherit;text-decoration:none}
#ft-sp-panel .ft-sp-th{flex:0 0 64px;width:64px;height:64px;border-radius:10px;object-fit:cover;background:#111}
#ft-sp-panel .ft-sp-th.ph{display:flex;align-items:center;justify-content:center;font-size:1.6rem;background:#1c1c1e}
#ft-sp-panel .ft-sp-rmain{flex:1;min-width:0}
#ft-sp-panel .ft-sp-sz-s .ft-sp-badges{margin:0 0 3px;flex-wrap:wrap;max-height:36px;overflow:hidden;gap:3px}
#ft-sp-panel .ft-sp-sz-s .ft-sp-tag{font-size:.54rem;padding:1px 6px}
#ft-sp-panel .ft-sp-sz-s .ft-sp-chip{font-size:.56rem;padding:1px 6px;white-space:nowrap}
#ft-sp-panel .ft-sp-sz-s .ft-sp-h{font-size:.92rem;margin:0;-webkit-line-clamp:1;line-height:1.25}
#ft-sp-panel .ft-sp-sz-s .ft-sp-tx{font-size:.74rem;-webkit-line-clamp:1;line-height:1.3}
#ft-sp-panel .ft-sp-meta{font-size:.64rem;font-weight:700;color:#ffd60a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
#ft-sp-panel .ft-sp-vac{border-style:dashed}
#ft-sp-panel .ft-sp-vac .ft-sp-meta{color:#32d74b}
#ft-sp-panel .ft-sp-chip.ft-sp-ok{color:#32d74b;border-color:rgba(50,215,75,.5)}
#ft-sp-panel .ft-sp-chev{flex:0 0 auto;font-size:1.5rem;line-height:1;color:#8e8e93;padding-left:2px}
/* medium = image left, text right */
#ft-sp-panel .ft-sp-sz-m .ft-sp-badges{flex:0 0 auto;max-height:46px;overflow:hidden;margin-bottom:8px}
#ft-sp-panel .ft-sp-mbody{display:flex;flex:1;min-height:0}
#ft-sp-panel .ft-sp-mlink{display:block;flex:0 0 112px;width:112px}
#ft-sp-panel .ft-sp-mlink .ft-sp-img,#ft-sp-panel .ft-sp-mbody .ft-sp-img{width:112px;height:100%;object-fit:cover}
#ft-sp-panel .ft-sp-sz-m .ft-sp-inner{flex:1;min-width:0;padding:0 12px 10px;overflow:hidden;display:flex;flex-direction:column}
#ft-sp-panel .ft-sp-sz-m .ft-sp-h{font-size:1.02rem;margin-bottom:4px}
#ft-sp-panel .ft-sp-sz-m .ft-sp-tx{font-size:.86rem;-webkit-line-clamp:3}
#ft-sp-panel .ft-sp-sz-m .ft-sp-btn{margin-top:auto;align-self:flex-start;padding:6px 14px;font-size:.78rem}
/* large */
#ft-sp-panel .ft-sp-sz-l .ft-sp-img{height:160px;object-fit:cover}
#ft-sp-panel .ft-sp-sz-l .ft-sp-h{font-size:1.2rem}
#ft-sp-panel .ft-sp-sz-l .ft-sp-tx{font-size:1rem;-webkit-line-clamp:4}
/* placeholder picture used in the size previews */
#ft-sp-panel .ft-sp-img.ph{display:flex;align-items:center;justify-content:center;background:#1c1c1e;color:#5a5a5e;font-weight:800;letter-spacing:.1em;font-size:.7rem}
#ft-sp-panel .ft-sp-sample{pointer-events:none;margin-bottom:6px}
/* ===== TOP 3 POSITIONS: special cards, bigger heading (#1 biggest) ===== */
/* ===== PREMIUM TOP 3: thin metallic gradient border, dark glass body, soft glow, small tier badge =====
   #1 = champagne GOLD (most premium, with a slow light sweep), #2 = PLATINUM, #3 = copper BRONZE */
#ft-sp-panel .ft-sp-p1,#ft-sp-panel .ft-sp-p2,#ft-sp-panel .ft-sp-p3{border:1.5px solid transparent;position:relative}
#ft-sp-panel .ft-sp-p1{background:linear-gradient(160deg,#2c2516,#1d1a13 70%) padding-box,linear-gradient(135deg,#fff3c4,#d4a017 35%,#8a6410 62%,#ffe08a) border-box;box-shadow:0 8px 26px rgba(212,160,23,.25),inset 0 1px 0 rgba(255,236,170,.12)}
#ft-sp-panel .ft-sp-p2{background:linear-gradient(160deg,#262a33,#1a1d23 70%) padding-box,linear-gradient(135deg,#f6f9fd,#9aa6b8 40%,#566175 65%,#dde5f1) border-box;box-shadow:0 6px 20px rgba(160,175,200,.16),inset 0 1px 0 rgba(255,255,255,.07)}
#ft-sp-panel .ft-sp-p3{background:linear-gradient(160deg,#2c211a,#1d1612 70%) padding-box,linear-gradient(135deg,#ffd7b5,#c27a45 40%,#774320 65%,#f2bb92) border-box;box-shadow:0 6px 20px rgba(194,122,69,.2),inset 0 1px 0 rgba(255,215,181,.08)}
#ft-sp-panel .ft-sp-p4{border-color:#4a6d94}
#ft-sp-panel .ft-sp-p5{border-color:#4a4a4e}
#ft-sp-panel .ft-sp-p1::after{content:"";position:absolute;top:0;bottom:0;left:0;width:45%;pointer-events:none;background:linear-gradient(105deg,transparent,rgba(255,240,190,.13),transparent);transform:translateX(-130%) skewX(-18deg);animation:ftSpSheen 5.5s ease-in-out infinite}
@keyframes ftSpSheen{0%,55%{transform:translateX(-130%) skewX(-18deg)}100%{transform:translateX(330%) skewX(-18deg)}}
@media (prefers-reduced-motion:reduce){#ft-sp-panel .ft-sp-p1::after{animation:none;display:none}}
/* metallic tier badges */
#ft-sp-panel .ft-sp-tag.tier.ft-sp-c-gold{color:#2b1d00;background:linear-gradient(135deg,#fff0b0,#d4a017);border-color:#ffe28a}
#ft-sp-panel .ft-sp-tag.tier.ft-sp-c-platinum{color:#151b26;background:linear-gradient(135deg,#f3f6fb,#9aa6b8);border-color:#dfe6f2}
#ft-sp-panel .ft-sp-tag.tier.ft-sp-c-bronze{color:#2a1405;background:linear-gradient(135deg,#ffd9b8,#bd7440);border-color:#f2bb92}
#ft-sp-panel .ft-sp-c-platinum{color:#dfe6f2;background:rgba(190,200,215,.16);border-color:rgba(190,200,215,.5)}
/* top 3 get bigger heading text (#1 biggest) - the size of the CARD itself never changes */
#ft-sp-panel .ft-sp-p1.ft-sp-sz-l .ft-sp-h{font-size:1.6rem;line-height:1.2;letter-spacing:.2px}
#ft-sp-panel .ft-sp-p2.ft-sp-sz-l .ft-sp-h{font-size:1.4rem;line-height:1.2}
#ft-sp-panel .ft-sp-p3.ft-sp-sz-l .ft-sp-h{font-size:1.25rem;line-height:1.2}
#ft-sp-panel .ft-sp-p1.ft-sp-sz-m .ft-sp-h{font-size:1.2rem}
#ft-sp-panel .ft-sp-p2.ft-sp-sz-m .ft-sp-h{font-size:1.12rem}
#ft-sp-panel .ft-sp-p3.ft-sp-sz-m .ft-sp-h{font-size:1.08rem}
#ft-sp-panel .ft-sp-p1.ft-sp-sz-s .ft-sp-h{font-size:1rem}
#ft-sp-panel .ft-sp-p2.ft-sp-sz-s .ft-sp-h{font-size:.96rem}
#ft-sp-panel .ft-sp-p3.ft-sp-sz-s .ft-sp-h{font-size:.94rem}
#ft-sp-panel .ft-sp-p1.ft-sp-sz-l .ft-sp-tx{font-size:1.05rem}
#ft-sp-panel .ft-sp-p2.ft-sp-sz-l .ft-sp-tx{font-size:1.02rem}
#ft-sp-panel .ft-sp-p1 .ft-sp-tag.tier{font-size:.78rem;padding:4px 10px}
#ft-sp-panel .ft-sp-c-silver{color:#e4e8f0;background:rgba(199,204,214,.18);border-color:rgba(199,204,214,.6)}
#ft-sp-panel .ft-sp-c-bronze{color:#ffb27a;background:rgba(255,159,90,.16);border-color:rgba(255,159,90,.6)}
/* ===== SLOT BOARD (rate card): 5 positions x S/M/L prices + live availability ===== */
#ft-sp-panel .ft-sp-sum{display:inline-block;font-size:.7rem;font-weight:800;padding:3px 9px;border-radius:10px}
#ft-sp-panel .ft-sp-sum.ok{color:#32d74b;background:rgba(50,215,75,.15);border:1px solid rgba(50,215,75,.5)}
#ft-sp-panel .ft-sp-sum.full{color:#ff6961;background:rgba(255,69,58,.15);border:1px solid rgba(255,69,58,.5)}
#ft-sp-panel .ft-sp-pos{border:1px solid #3a3a3c;border-radius:12px;padding:10px;margin:0 0 10px;background:#1c1c1e}
#ft-sp-panel .ft-sp-pos.free{border-color:rgba(50,215,75,.55);background:rgba(50,215,75,.07)}
#ft-sp-panel .ft-sp-pos.taken{opacity:.72}
#ft-sp-panel .ft-sp-pos-top{display:flex;align-items:center;gap:8px;margin-bottom:8px}
#ft-sp-panel .ft-sp-pos-name{flex:1;min-width:0;font-weight:800;font-size:.92rem;color:#fff}
#ft-sp-panel .ft-sp-st{flex-shrink:0;font-size:.66rem;font-weight:800;letter-spacing:.06em;padding:3px 9px;border-radius:10px}
#ft-sp-panel .ft-sp-st.free{color:#0b0b0c;background:#32d74b}
#ft-sp-panel .ft-sp-st.taken{color:#ff6961;background:rgba(255,69,58,.16);border:1px solid rgba(255,69,58,.5)}
#ft-sp-panel .ft-sp-st.hold{color:#ffb340;background:rgba(255,159,10,.16);border:1px solid rgba(255,159,10,.5)}
#ft-sp-panel .ft-sp-prices{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
#ft-sp-panel .ft-sp-pc{text-align:center;background:#2c2c2e;border:1px solid #3a3a3c;border-radius:8px;padding:6px 2px}
#ft-sp-panel .ft-sp-pc.ok{border-color:rgba(50,215,75,.55)}
#ft-sp-panel .ft-sp-pc.no{opacity:.6}
#ft-sp-panel .ft-sp-pc em{display:block;font-style:normal;font-size:.58rem;font-weight:800;letter-spacing:.05em;margin-top:2px;color:#8e8e93}
#ft-sp-panel .ft-sp-pc.ok em{color:#32d74b}
#ft-sp-panel .ft-sp-pc.no em{color:#ff6961}
#ft-sp-panel .ft-sp-booknow{display:block;width:100%;margin-top:10px;padding:11px;border:0;border-radius:20px;background:#32d74b;color:#0b0b0c;font:inherit;font-weight:800;font-size:.88rem;cursor:pointer}
#ft-sp-panel .ft-sp-bkopts{display:none;margin-top:8px}
#ft-sp-panel .ft-sp-bkopts.open{display:block}
#ft-sp-panel .ft-sp-bkrow{display:flex;align-items:center;gap:10px;margin-top:8px;padding:10px 12px;border-radius:12px;text-decoration:none;color:#fff!important;background:#2c2c2e;border:1px solid #5a5a5e}
#ft-sp-panel .ft-sp-bkrow.em{border-color:#32d74b}
#ft-sp-panel .ft-sp-bkrow.tg{border-color:#2aabee}
#ft-sp-panel .ft-sp-bkrow .ico{font-size:1.3rem;width:28px;text-align:center}
#ft-sp-panel .ft-sp-bkrow .bt{flex:1;min-width:0}
#ft-sp-panel .ft-sp-bkrow .bt b{display:block;font-size:.84rem}
#ft-sp-panel .ft-sp-bkrow .bt i{display:block;font-style:normal;font-size:.9rem;font-weight:700;overflow-wrap:anywhere}
#ft-sp-panel .ft-sp-bkrow.em .bt i{color:#32d74b}
#ft-sp-panel .ft-sp-bkrow.tg .bt i{color:#5bc0f8}
#ft-sp-panel .ft-sp-bkrow .go{font-size:.75rem;font-weight:700;color:#8e8e93}
#ft-sp-panel .ft-sp-pc i{display:block;font-style:normal;font-size:.58rem;font-weight:800;letter-spacing:.06em;color:#8e8e93}
#ft-sp-panel .ft-sp-pc b{display:block;font-size:.86rem;color:#fff;margin-top:1px}
#ft-sp-panel .ft-sp-until{font-size:.7rem;color:#8e8e93;margin-top:6px}
#ft-sp-panel a.ft-sp-book{display:block;margin-top:8px;text-align:center;padding:9px;border-radius:18px;background:#32d74b;color:#0b0b0c!important;font-weight:800;font-size:.82rem;text-decoration:none}
#ft-sp-panel .ft-sp-legend{font-size:.72rem;color:#8e8e93;margin:2px 0 10px;line-height:1.5}
/* "Advertise" button in the panel heading */
#ft-sp-panel .ft-sp-adv{display:none;flex-shrink:0;font:inherit;font-size:.78rem;font-weight:800;padding:7px 13px;border-radius:16px;border:0;background:#0a84ff;color:#fff;cursor:pointer}
#ft-sp-panel .ft-sp-adv:hover{background:#2b95ff}
#ft-sp-panel .ft-sp-adv.show{display:inline-block}
/* booking buttons (Telegram + Email) and next-free-date text */
#ft-sp-panel .ft-sp-bk{display:flex;gap:8px;margin-top:8px}
#ft-sp-panel .ft-sp-bk a{flex:1;text-align:center;padding:9px 4px;border-radius:18px;font-weight:800;font-size:.78rem;text-decoration:none;color:#0b0b0c!important}
#ft-sp-panel .ft-sp-bk a.tg{background:#2aabee}
#ft-sp-panel .ft-sp-bk a.em{background:#32d74b}
#ft-sp-panel .ft-sp-bkcap{font-size:.74rem;color:#d1d1d6;margin-top:2px}
#ft-sp-panel .ft-sp-next{font-size:.74rem;font-weight:700;color:#ffb340;margin-top:6px}
#ft-sp-panel .ft-sp-gtog{display:block;width:100%;margin:4px 0 10px;padding:8px;font:inherit;font-size:.78rem;font-weight:700;color:#ffd60a;background:transparent;border:1px dashed #5a5a5e;border-radius:10px;cursor:pointer}
#ft-sp-panel .ft-sp-guide{display:none;margin-bottom:10px}
#ft-sp-panel .ft-sp-guide.open{display:block}
#ft-sp-panel .ft-sp-gcap{font-size:.72rem;color:#8e8e93;margin:8px 0 4px;line-height:1.4}
/* ===== HERO: offer + slot status in ONE compact block (big price, status dots, Show more) ===== */
#ft-sp-panel .ft-sp-cur{margin-left:auto;font:inherit;font-size:.7rem;font-weight:800;color:#fff;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.28);border-radius:999px;padding:5px 9px;cursor:pointer;white-space:nowrap}
#ft-sp-panel .ft-sp-cur + .ft-sp-adv{margin-left:6px}
#ft-sp-panel .ft-sp-hero{margin:0 0 12px;border-radius:14px;border:1px solid rgba(10,132,255,.65);background:linear-gradient(100deg,#0e3f80,#0a2447 60%,#0b1a30);overflow:hidden;position:relative;box-shadow:0 4px 18px rgba(10,132,255,.28)}
#ft-sp-panel .ft-sp-hero-top{display:flex;align-items:center;gap:10px;padding:9px 10px}
#ft-sp-panel .ft-sp-bigp{flex:0 0 auto;text-align:center;line-height:1;padding-right:11px;border-right:1px solid rgba(255,255,255,.22)}
#ft-sp-panel .ft-sp-bigp span{display:block;font-size:2.1rem;font-weight:900;letter-spacing:-.5px;background:linear-gradient(180deg,#fff7cf,#ffc12e);-webkit-background-clip:text;background-clip:text;color:transparent;animation:ftSpPulse 2.4s ease-in-out infinite}
#ft-sp-panel .ft-sp-bigp small{display:block;margin-top:4px;font-size:.58rem;font-weight:800;letter-spacing:.1em;color:#cfe3ff;text-transform:uppercase}
@keyframes ftSpPulse{0%,100%{filter:drop-shadow(0 0 0 rgba(255,193,46,0))}50%{filter:drop-shadow(0 0 9px rgba(255,193,46,.75))}}
@media (prefers-reduced-motion:reduce){#ft-sp-panel .ft-sp-bigp span{animation:none}}
#ft-sp-panel .ft-sp-hero-mid{flex:1;min-width:0}
#ft-sp-panel .ft-sp-hero-t{font-size:.8rem;font-weight:800;color:#fff;line-height:1.25;margin-bottom:6px}
#ft-sp-panel .ft-sp-hero-t b{color:#ffd60a}
#ft-sp-panel .ft-sp-dots{display:flex;align-items:center;gap:5px}
#ft-sp-panel .ft-sp-dot2{width:23px;height:23px;border-radius:50%;font:inherit;font-size:.66rem;font-weight:800;border:1.5px solid;cursor:pointer;padding:0;line-height:1}
#ft-sp-panel .ft-sp-dot2.free{color:#32d74b;border-color:#32d74b;background:rgba(50,215,75,.16)}
#ft-sp-panel .ft-sp-dot2.busy{color:#ff7b73;border-color:#ff6961;background:rgba(255,69,58,.14)}
#ft-sp-panel .ft-sp-dots em{font-style:normal;font-size:.58rem;font-weight:700;color:#9fc4f5;margin-left:3px}
#ft-sp-panel .ft-sp-hero.open .ft-sp-offer-more{display:block}
#ft-sp-panel .ft-sp-hero .ft-sp-offer-more{padding:0 12px 10px;font-size:.78rem;color:#dbe9ff}
/* VACANT slot: green dashed "empty slot" look with a plus sign */
#ft-sp-panel .ft-sp-vac{border:1.5px dashed rgba(50,215,75,.7)!important;background:repeating-linear-gradient(135deg,rgba(50,215,75,.07) 0 8px,rgba(50,215,75,.02) 8px 16px),#1c1c1e!important;box-shadow:none!important}
#ft-sp-panel .ft-sp-vac::after{display:none!important}
#ft-sp-panel .ft-sp-vac .ft-sp-th.ph{background:transparent;border:2px dashed rgba(50,215,75,.7);color:#32d74b;font-size:2rem;font-weight:300}
#ft-sp-panel .ft-sp-vac .ft-sp-h{color:#32d74b!important}
/* AD (ad network): neutral grey "ADVERTISEMENT" frame */
#ft-sp-panel .ft-sp-ad{background:#101012!important;border:1px solid #4a4a4e!important;border-radius:6px;box-shadow:none!important}
#ft-sp-panel .ft-sp-ad .ft-sp-badges{justify-content:center}
#ft-sp-panel .ft-sp-ad .ft-sp-tag{background:none!important;border:0!important;color:#8e8e93!important;letter-spacing:.18em;font-size:.58rem}
/* BOOKING board + sheet: navy-blue panel */
#ft-sp-panel .ft-sp-rates,#ft-sp-panel .ft-sp-sheet{background:linear-gradient(180deg,#10233f,#0b1626)!important;border-color:rgba(10,132,255,.5)!important}
#ft-sp-panel .ft-sp-rates .ft-sp-pos,#ft-sp-panel .ft-sp-sheet .ft-sp-ch,#ft-sp-panel .ft-sp-sheet .ft-sp-in{background:rgba(255,255,255,.05);border-color:rgba(120,170,235,.3)}
#ft-sp-panel .ft-sp-sheet .ft-sp-ch.sel{border-color:#0a84ff;background:rgba(10,132,255,.25)}
/* thin OFFER bar at the very top: one line + "Show more" */
#ft-sp-panel .ft-sp-offer{margin:0 0 12px;border-radius:12px;border:1px solid rgba(10,132,255,.55);background:linear-gradient(100deg,rgba(10,132,255,.20),rgba(10,132,255,.06));overflow:hidden}
#ft-sp-panel .ft-sp-offer-top{display:flex;align-items:center;gap:8px;padding:8px 10px}
#ft-sp-panel .ft-sp-offer-t{flex:1;min-width:0;font-size:.78rem;font-weight:700;line-height:1.3;color:#fff}
#ft-sp-panel .ft-sp-offer-t b{color:#ffd60a}
#ft-sp-panel .ft-sp-offer-b{flex-shrink:0;font:inherit;font-size:.7rem;font-weight:800;padding:5px 10px;border-radius:12px;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.1);color:#fff;cursor:pointer;white-space:nowrap}
#ft-sp-panel .ft-sp-offer-more{display:none;padding:2px 12px 12px;font-size:.82rem;line-height:1.5;color:#d1d1d6}
#ft-sp-panel .ft-sp-offer.open .ft-sp-offer-more{display:block}
#ft-sp-panel .ft-sp-offer-cta{display:flex;gap:8px;margin-top:10px}
#ft-sp-panel .ft-sp-offer-cta button{flex:1;font:inherit;font-size:.78rem;font-weight:800;padding:9px 4px;border-radius:16px;border:0;cursor:pointer}
#ft-sp-panel .ft-sp-offer-cta .a{background:#32d74b;color:#0b0b0c}
#ft-sp-panel .ft-sp-offer-cta .b{background:rgba(255,255,255,.12);color:#fff}
/* availability strip under the heading: 5 pills, green = free, red = booked */
#ft-sp-panel .ft-sp-strip{display:flex;align-items:center;gap:6px;margin:0 0 12px}
#ft-sp-panel .ft-sp-strip .lbl{font-size:.68rem;font-weight:800;letter-spacing:.05em;color:#8e8e93;margin-right:2px}
#ft-sp-panel .ft-sp-sp{flex:1;font:inherit;font-size:.72rem;font-weight:800;padding:6px 0;border-radius:14px;border:1px solid;cursor:pointer;background:transparent}
#ft-sp-panel .ft-sp-sp.free{color:#32d74b;border-color:rgba(50,215,75,.6);background:rgba(50,215,75,.1)}
#ft-sp-panel .ft-sp-sp.busy{color:#ff6961;border-color:rgba(255,69,58,.5);background:rgba(255,69,58,.08)}
/* BOOKING SHEET (slides over the panel) */
#ft-sp-panel .ft-sp-sheet{display:none;position:absolute;left:0;right:0;bottom:0;top:0;background:#1c1c1e;z-index:5;flex-direction:column}
#ft-sp-panel .ft-sp-sheet.open{display:flex}
#ft-sp-panel .ft-sp-sh-head{display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid #3a3a3c;flex-shrink:0}
#ft-sp-panel .ft-sp-sh-head b{flex:1;font-size:1.02rem}
#ft-sp-panel .ft-sp-sh-body{flex:1;overflow-y:auto;padding:14px;-webkit-overflow-scrolling:touch}
#ft-sp-panel .ft-sp-sh-l{font-size:.72rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#8e8e93;margin:14px 0 6px}
#ft-sp-panel .ft-sp-sh-l:first-child{margin-top:0}
#ft-sp-panel .ft-sp-chs{display:flex;flex-wrap:wrap;gap:6px}
#ft-sp-panel .ft-sp-ch{font:inherit;flex:1 1 0;min-width:64px;padding:8px 6px;border-radius:12px;border:1px solid #3a3a3c;background:#2c2c2e;color:#fff;cursor:pointer;text-align:center;line-height:1.25}
#ft-sp-panel .ft-sp-ch b{display:block;font-size:.9rem}
#ft-sp-panel .ft-sp-ch i{display:block;font-style:normal;font-size:.62rem;color:#8e8e93;margin-top:2px}
#ft-sp-panel .ft-sp-ch.sel{border-color:#32d74b;background:rgba(50,215,75,.16)}
#ft-sp-panel .ft-sp-ch.sel i{color:#32d74b}
#ft-sp-panel .ft-sp-ch.dis{opacity:.4;cursor:not-allowed}
#ft-sp-panel .ft-sp-in{width:100%;box-sizing:border-box;font:inherit;font-size:.9rem;padding:10px 12px;border-radius:10px;border:1px solid #3a3a3c;background:#2c2c2e;color:#fff;margin-bottom:6px;color-scheme:dark}
#ft-sp-panel textarea.ft-sp-in{min-height:64px;resize:vertical}
#ft-sp-panel .ft-sp-sum2{margin:14px 0 8px;padding:12px;border-radius:12px;background:rgba(50,215,75,.08);border:1px solid rgba(50,215,75,.4);font-size:.86rem;line-height:1.55}
#ft-sp-panel .ft-sp-sum2 .tot{font-size:1.15rem;font-weight:800;color:#32d74b}
#ft-sp-panel .ft-sp-copy2{display:block;width:100%;margin-top:8px;padding:9px;font:inherit;font-size:.8rem;font-weight:700;color:#d1d1d6;background:transparent;border:1px dashed #5a5a5e;border-radius:12px;cursor:pointer}
#ft-sp-panel .ft-sp-small-note{font-size:.72rem;color:#8e8e93;margin-top:8px;line-height:1.5}
#ft-sp-panel .ft-sp-startbook{display:block;width:100%;margin:0 0 10px;padding:11px;border:0;border-radius:20px;background:#0a84ff;color:#fff;font:inherit;font-weight:800;font-size:.88rem;cursor:pointer}
#ft-sp-panel .ft-sp-foot a{color:#8e8e93;text-decoration:underline}
#ft-sp-panel .ft-sp-foot{margin:4px 2px 16px;font-size:.7rem;line-height:1.45;color:#8e8e93;text-align:center}
#ft-sp-panel .ft-sp-img{display:block;width:100%;height:auto;background:#111}
#ft-sp-panel .ft-sp-inner{padding:10px 14px 14px}
#ft-sp-panel .ft-sp-h{font-size:1rem;font-weight:700;margin:0 0 6px;color:#fff}
#ft-sp-panel .ft-sp-t{font-size:.9rem;line-height:1.5;color:#d1d1d6;word-wrap:break-word;overflow-wrap:anywhere}
#ft-sp-panel .ft-sp-t a{color:#32d74b}
#ft-sp-panel .ft-sp-btn{display:inline-block;margin-top:12px;padding:9px 18px;border-radius:20px;background:#32d74b;color:#0b0b0c!important;font-weight:700;font-size:.85rem;text-decoration:none}
#ft-sp-panel .ft-sp-btn:hover{filter:brightness(1.1)}
#ft-sp-panel a.ft-sp-imglink{display:block}
/* contact rows (email / Telegram ...) with a Copy button */
#ft-sp-panel .ft-sp-contacts{margin-top:10px;display:flex;flex-direction:column;gap:8px}
#ft-sp-panel .ft-sp-contact{display:flex;align-items:center;gap:10px;background:#1c1c1e;border:1px solid #3a3a3c;border-radius:10px;padding:8px 10px}
#ft-sp-panel .ft-sp-ct{flex:1;min-width:0}
#ft-sp-panel .ft-sp-cl{font-size:.6rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#8e8e93}
#ft-sp-panel .ft-sp-cv{font-size:.8rem;font-weight:600;color:#fff;overflow-wrap:anywhere}
#ft-sp-panel .ft-sp-cb{flex-shrink:0;font:inherit;font-size:.75rem;font-weight:700;padding:7px 12px;border-radius:16px;border:1px solid #32d74b;background:transparent;color:#32d74b!important;text-decoration:none;cursor:pointer;line-height:1.2}
#ft-sp-panel .ft-sp-cb.fill{background:#32d74b;color:#0b0b0c!important}
/* "Show more" section: hidden until the visitor asks */
#ft-sp-panel .ft-sp-more{display:none;margin-top:10px;padding-top:10px;border-top:1px dashed #3a3a3c}
#ft-sp-panel .ft-sp-item.open .ft-sp-more{display:block}
#ft-sp-panel .ft-sp-tog{display:block;width:100%;margin-top:10px;padding:8px;font:inherit;font-size:.8rem;font-weight:600;color:#32d74b;background:transparent;border:0;border-top:1px solid #3a3a3c;cursor:pointer}
/* raw-HTML ads live in a sandboxed iframe with a TRANSPARENT background (the dark card shows through); set "background" on an entry to force a colour */
#ft-sp-panel .ft-sp-frame{display:block;width:100%;border:0;background:transparent;color-scheme:normal}

/* ===== STANDALONE PAGE MODE: panel is a normal block in the page (not a fixed overlay) ===== */
html,body{margin:0;background:#000;color:#f2f2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}
.sp-top{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:10px;height:56px;padding:0 14px;background:#1c1c1e;border-bottom:1px solid #3a3a3c}
.sp-top a{color:#fff;text-decoration:none}
.sp-logo{display:flex;align-items:center;gap:8px;font-weight:800;font-size:1.05rem}
.sp-logo{font-size:1.2rem;letter-spacing:-.02em}
.sp-logo .logo-tv-box{background:var(--brand-accent-color,#32d74b);width:28px;height:28px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.sp-logo .logo-tv-box svg{width:17px;height:17px}
.sp-back{margin-left:auto;font-size:.82rem;font-weight:700;background:#0a84ff;border-radius:999px;padding:8px 14px}
#sp-root{max-width:760px;margin:0 auto;min-height:calc(100vh - 56px)}
#ft-sp-panel{position:relative!important;inset:auto!important;display:flex!important;width:auto!important;max-width:none!important;height:auto!important;border:0!important;box-shadow:none!important;background:#1c1c1e;min-height:calc(100vh - 56px)}
/* FIX: hide ONLY the panel header close button on this standalone page. The old rule hid every .ft-sp-x, so the booking popup had no close button */
#ft-sp-panel .ft-sp-head .ft-sp-x{display:none!important}
#ft-sp-panel .ft-sp-head{position:static}
#ft-sp-panel .ft-sp-body{overflow:visible!important;flex:1 1 auto;height:auto!important}
/* booking sheet = centred modal over the page (it was an in-panel overlay) */
#ft-sp-panel .ft-sp-sheet{position:fixed!important;inset:0!important;max-width:560px;margin:0 auto;z-index:4400;overflow:auto}
 /* ===== PC / wide screens: two columns. Left = hero + ads, right = sticky slot board + prices ===== */
@media (min-width:900px){
  #sp-root{max-width:1140px;padding:0 24px;box-sizing:border-box}
  #ft-sp-panel{background:transparent!important}
  #ft-sp-panel .ft-sp-head{padding:18px 0 6px;background:transparent;border:0}
  #ft-sp-panel .ft-sp-title{font-size:1.5rem}
  #ft-sp-panel .ft-sp-body{display:grid;grid-template-columns:minmax(0,1fr) 390px;column-gap:22px;align-items:start;padding:10px 0 24px}
  #ft-sp-panel .ft-sp-body>.ft-sp-hero{grid-column:1/-1}
  #ft-sp-panel .ft-sp-body>.ft-sp-item{grid-column:1}
  #ft-sp-panel .ft-sp-body>.ft-sp-rates{grid-column:2;grid-row:2/span 40;position:sticky;top:72px;max-height:calc(100vh - 90px);overflow:auto;margin:0}
  #ft-sp-panel .ft-sp-body>.ft-sp-foot{grid-column:1/-1}
  #ft-sp-panel .ft-sp-bigp span{font-size:2.8rem}
  #ft-sp-panel .ft-sp-hero-t{font-size:1.05rem}
  #ft-sp-panel .ft-sp-hero-top{padding:14px 18px;gap:18px}
  #ft-sp-panel .ft-sp-dot2{width:30px;height:30px;font-size:.8rem}
  #ft-sp-panel .ft-sp-sheet{inset:5vh 0 auto 0!important;bottom:auto!important;max-height:90vh;border-radius:16px;border:1px solid rgba(10,132,255,.5);box-shadow:0 20px 60px rgba(0,0,0,.7)}
  .sp-top{padding:0 max(24px,calc((100vw - 1092px)/2))}
}
/* FIX (booking popup): dark backdrop so it reads as a popup, close button never squashed, page behind does not scroll */
#ft-sp-panel .ft-sp-sheet{box-shadow:0 20px 60px rgba(0,0,0,.7),0 0 0 100vmax rgba(0,0,0,.72)!important}
#ft-sp-panel .ft-sp-sheet .ft-sp-sh-head .ft-sp-x{flex-shrink:0;display:inline-block!important}
html.ft-sp-lock,html.ft-sp-lock body{overflow:hidden}
.sp-note{max-width:760px;margin:0 auto;padding:14px;font-size:.72rem;color:#8e8e93;text-align:center}
</style>
