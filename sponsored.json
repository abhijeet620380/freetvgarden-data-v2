    return'<div class="ft-sp-rates'+(open?' open':'')+'" id="ft-sp-rates"><span class="ft-sp-badges"><span class="ft-sp-tag ft-sp-c-gold">'+esc(r.label||"Advertise")+'</span>'+sumH+'</span><div class="ft-sp-inner"><div class="ft-sp-h">'+title+'</div>'+
      '<div class="ft-sp-rates-body">'+bodyH+(r.note?'<div class="ft-sp-t" style="margin-top:8px;font-size:.78rem;color:#8e8e93">'+esc(r.note)+'</div>':"")+'</div></div>'+
      '<button type="button" class="ft-sp-tog" data-rates="1" data-show="'+esc(r.button||"View all 15 slots & availability")+'" data-hide="Hide slots">'+esc(open?"Hide slots":(r.button||"View all 15 slots & availability"))+'</button></div>'}
  function renderItem(it){
    var id=it.id||("i"+it.__i), tag=esc(it.label||(it.html?"Ad":"Sponsored")),
